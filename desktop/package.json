{
  "name": "vocab-trace",
  "productName": "词迹",
  "version": "1.0.7",
  "private": true,
  "description": "认读型背词工具",
  "author": {
    "name": "柳重名神",
    "email": "liuqiwei512@163.com"
  },
  "homepage": "https://github.com/vocab-trace/vocab-trace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "node build.js",
    "setup": "electron-builder --win nsis --config electron-builder.json",
    "build": "electron-builder --config electron-builder.json",
    "build:linux": "electron-builder --linux --config electron-builder.json"
  },
  "build": {
    "appId": "com.vocabtrace.app",
    "productName": "词迹",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/index.html",
      "app/seed.js",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "appimage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "icon-512.png",
      "artifactName": "词迹-${version}-${arch}.${ext}",
      "synopsis": "认读型背词工具",
      "desktop": {
        "entry": {
          "Name": "词迹",
          "Comment": "认读型背词工具",
          "Categories": "Education;"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  }
}

