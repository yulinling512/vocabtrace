      "id": "w_address",
      "word": "address",
      "phonetic": "/əˈdres/",
      "senses": [
        { "pos": "n.", "meaning": "地址；住址", "tags": ["常用"] },
        { "pos": "v.", "meaning": "处理；应对", "tags": ["高频"] },
        { "pos": "v.", "meaning": "向……讲话；致辞", "tags": [] }
      ],
      "etymology": {
        "text": "源自古法语 addresser，再往前是拉丁俗语 ad-directiare，本义为「使某物朝向、摆正」。ad- 表方向，directus 意为「引导、取直」。因为「把话对准某人」就是致辞，「把事摆正」就是处理，所以同一词根后来分化出「讲话」与「应对」两路含义。",
        "roots": [
          { "part": "ad-", "gloss": "朝向" },
          { "part": "directus", "gloss": "取直、引导" }
        ],
        "source": "etymonline",
        "confidence": "high"
      },
      "mnemonic": "把方向（ad-）对准某人，就是「致辞」；把乱事摆正（direct），就是「处理」。一个词干两件事，都是「对准」。",
      "examples": [
        { "en": "She addressed the crowd for ten minutes.", "zh": "她向人群致辞了十分钟。" },
        { "en": "We must address this problem first.", "zh": "我们必须先处理这个问题。" }
      ],
      "enrichedAt": "2026-11-25T13:54:00Z"
