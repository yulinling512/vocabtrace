    {
      "id": "w_serendipity",
      "word": "serendipity",
      "phonetic": "/ˌserənˈdɪpəti/",
      "senses": [
        { "pos": "n.", "meaning": "意外发现美好事物的运气；机缘巧合", "tags": ["学术", "低频"] }
      ],
      "etymology": {
        "text": "1754 年由英国作家 Horace Walpole 生造，取自波斯童话《The Three Princes of Serendip》（锡兰三王子）。故事里三位王子在旅途中总能凭着敏锐观察，意外发现并非刻意寻找的东西。Walpole 便用 Serendip（锡兰古称，今斯里兰卡）造出这个词，专指「本来没在找、却意外碰上好东西」的能力。",
        "roots": [
          { "part": "Serendip", "gloss": "锡兰古称，今斯里兰卡" }
        ],
        "source": "wiktionary",
        "confidence": "high"
      },
      "mnemonic": "锡兰三王子（Serendip）一路随手捡到宝，所以 serendipity 不是「运气好」，是「有本事把意外变成收获」。",
      "examples": [
        { "en": "Meeting her was pure serendipity.", "zh": "遇见她纯属机缘巧合。" }
      ],
      "enrichedAt": "2026-11-25T13:54:00Z"
    },
