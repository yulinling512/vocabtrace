/* 核心义 */
.core{background:var(--accent-soft);border-radius:12px;padding:16px 18px;border:1px solid transparent}
.core .sline{display:flex;gap:9px;align-items:baseline}
.core .sline+.sline{
  margin-top:9px;padding-top:9px;
  border-top:1px solid color-mix(in srgb,var(--accent) 16%,transparent)
}
.core .pos2{
  flex-shrink:0;font-size:calc(10.5px * var(--fs));color:var(--accent);background:var(--surface);
  padding:1px 6px;border-radius:4px;font-family:Georgia,serif;font-weight:600
}
.core b{font-weight:600;font-size:calc(19px * var(--fs));color:var(--ink);line-height:1.55}

/* 形义钩子 */
.hook{background:var(--bg);border-radius:12px;padding:16px 18px}
.hook .cut{font-family:Georgia,serif;font-size:calc(21px * var(--fs));letter-spacing:.5px;margin-bottom:12px;display:flex;flex-wrap:wrap;align-items:baseline;gap:2px}
.hook .cut span{padding:0 1px;border-radius:3px;transition:.2s}
.hook .cut b{color:var(--accent);font-weight:600;background:var(--accent-soft);padding:1px 5px}
.hook .cut i{color:var(--faint);font-style:normal;font-size:calc(13px * var(--fs));margin-left:2px}
.hook .line{font-size:calc(14.5px * var(--fs));color:var(--text2);line-height:1.8}
.hook .line em{font-style:normal;color:var(--accent);font-weight:600}
.hook .tip{margin-top:10px;padding-top:10px;border-top:1px dashed var(--line);display:flex;gap:8px;align-items:flex-start;font-size:calc(14px * var(--fs));color:var(--text2);line-height:1.78}
.hook .tip .tl{flex:none;margin-top:2px;font-size:calc(10.5px * var(--fs));letter-spacing:.8px;line-height:1.6;color:var(--tone,var(--accent));border:1px solid currentColor;border-radius:4px;padding:0 5px;opacity:.8}
.hook .tip b{color:var(--tone,var(--accent));font-weight:600}

/* 例句 */
.eg{margin-bottom:12px}
.eg:last-child{margin-bottom:0}
.eg .en{font-family:Georgia,serif;font-size:calc(15px * var(--fs));color:var(--ink);line-height:1.7}
.eg .en u{text-decoration:none;background:linear-gradient(transparent 62%,var(--accent-soft) 62%);padding:0 1px}
.eg .cn{font-size:calc(13px * var(--fs));color:var(--muted);margin-top:3px;line-height:1.7}
.eg .cn em{font-style:normal;color:var(--accent);font-weight:500}

/* 搭配 / 易混 */
.tags{display:flex;flex-wrap:wrap;gap:7px}
.tags span{
  font-size:calc(12.5px * var(--fs));background:var(--surface);border:1px solid var(--line);
  color:var(--text2);padding:3px 10px;border-radius:6px;font-family:Georgia,serif
}
.mixrow{display:flex;gap:10px;align-items:baseline;font-size:calc(13px * var(--fs));margin-bottom:7px}
.mixrow:last-child{margin-bottom:0}
.mixrow b{font-family:Georgia,serif;color:var(--warn);font-weight:600;min-width:96px}
.mixrow span{color:var(--muted)}

/* 词源（正面主区块，默认为展开） */
.ety2{width:100%}
.blk-h.etyh{display:flex;align-items:center;gap:7px;cursor:pointer;user-select:none}
.blk-h.etyh .arw{transition:.22s var(--ease);font-size:calc(10px * var(--fs));color:var(--faint);transform:rotate(180deg)}
.blk-h.etyh.closed .arw{transform:none}
.ety2 .body{display:none}
.ety2.open .body{display:block;animation:fadeUp .26s var(--ease) both}
.ety2 p{font-size:calc(13.5px * var(--fs));color:var(--text2);line-height:1.92;text-align:left}
.ety2 .src2{font-size:calc(9.5px * var(--fs));color:var(--faint);border:1px solid var(--line);padding:0 5px;border-radius:3px;letter-spacing:0;font-weight:400}
.ety2 .src2.warn{color:var(--warn);border-color:var(--warn);opacity:.8}

/* 记法 */
.mn2{
  width:100%;background:var(--note-bg);border-radius:10px;padding:13px 15px;
  font-size:calc(13.5px * var(--fs));color:var(--note-ink);line-height:1.82;text-align:left
}
.mn2 b{display:block;font-size:calc(10.5px * var(--fs));letter-spacing:1.2px;opacity:.75;margin-bottom:4px;font-weight:600}

/* ===== 背诵页：一屏放得下，看完直接点按钮，不用滚 ===== */
body[data-view="read"]{padding-bottom:0;overflow:hidden}
#view-read{
  display:flex;flex-direction:column;height:calc(100vh - 46px);
  overflow:hidden;padding-bottom:8px;box-sizing:border-box
}
#view-read .pagehd{flex:0 0 auto;margin:8px 0 6px}
#view-read .card{
  flex:1 1 auto;min-height:0;padding:22px 26px 18px;justify-content:center;
  overflow-y:auto;overscroll-behavior:contain;
  scrollbar-width:thin;scrollbar-color:var(--line) transparent
}
#view-read .card.full{justify-content:flex-start}
#view-read .row,#view-read .kbd{flex:0 0 auto}
#view-read .card::-webkit-scrollbar{width:6px}
#view-read .card::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}
#view-read .cw .w{font-size:calc(36px * var(--fs))}
#view-read .cw .ph{font-size:calc(13px * var(--fs));margin-top:5px}
#view-read .blk{margin-top:13px}
#view-read .blk-h{margin-bottom:7px;font-size:calc(10px * var(--fs));letter-spacing:1.1px}
#view-read .core{padding:12px 14px}
#view-read .core b{font-size:calc(16.5px * var(--fs));line-height:1.5}
#view-read .core .sline+.sline{margin-top:7px;padding-top:7px}
#view-read .hook{padding:11px 14px}
#view-read .hook .cut{font-size:calc(17.5px * var(--fs));margin-bottom:7px}
#view-read .hook .line{font-size:calc(13px * var(--fs));line-height:1.65}
#view-read .hook .tip{margin-top:8px;padding-top:8px;font-size:calc(12.8px * var(--fs));line-height:1.62}
#view-read .ety2 p{font-size:calc(12.5px * var(--fs));line-height:1.72}
#view-read .ety2 .roots{margin-top:8px}
#view-read .eg{margin-bottom:0}
#view-read .eg .en{font-size:calc(13.5px * var(--fs));line-height:1.55}
#view-read .eg .cn{font-size:calc(12px * var(--fs));margin-top:2px;line-height:1.55}
#view-read .tags span{font-size:calc(11.5px * var(--fs));padding:2px 8px}
#view-read .mixrow{margin-bottom:4px}
#view-read .row{margin-top:14px}
#view-read .kbd{margin-top:8px}

/* ===== 每个词的「情绪色调」：由当前主题的主色转出来，仍是一家人 ===== */
.card{--tone:var(--accent);position:relative}
.card[data-tone="warm"]{--tone:#C0703A}
.card[data-tone="cool"]{--tone:#3A6EA5}
.card[data-tone="dark"]{--tone:#8E3B3B}
.card[data-tone="bright"]{--tone:#A0801A}
.card[data-tone="calm"]{--tone:#3F7A6C}
.card[data-tone="sharp"]{--tone:#8B4580}
.card::before{
  content:"";position:absolute;top:0;left:0;right:0;height:3px;
  background:var(--tone);opacity:.9;border-radius:16px 16px 0 0
}
.card .core{
  background:color-mix(in srgb,var(--tone) 10%,transparent);
  border-color:color-mix(in srgb,var(--tone) 20%,transparent)
}
.card .core .pos2{color:var(--tone);background:color-mix(in srgb,var(--surface) 80%,transparent)}
.card .hook .cut b{color:var(--tone);background:color-mix(in srgb,var(--tone) 13%,transparent)}
.card .hook .line em{color:var(--tone)}
.card .eg .en u{
  background:linear-gradient(transparent 56%,color-mix(in srgb,var(--tone) 28%,transparent) 56%);
  font-weight:600
}
.card .eg .cn em{color:var(--tone)}
.card .mixrow b{color:var(--tone)}

/* 意象图标 */
.ico{font-size:calc(54px * var(--fs));line-height:1;margin-bottom:16px;user-select:none;filter:saturate(1.05)}
.ico.sm{font-size:calc(27px * var(--fs));margin-bottom:9px;opacity:.9}

/* ========== 主题选择器 ========== */
.themes{display:flex;gap:12px;flex-wrap:wrap}
.th{
  cursor:pointer;border:0;background:transparent;padding:0;font-family:inherit;
  display:flex;flex-direction:column;align-items:center;gap:7px;width:66px
}
.th .sw{
  width:44px;height:44px;border-radius:13px;border:2px solid var(--line);
  position:relative;transition:.2s var(--ease);overflow:hidden
}
.th .sw i{position:absolute;left:0;top:0;width:100%;height:52%}
.th .sw u{position:absolute;right:6px;bottom:6px;width:9px;height:9px;border-radius:50%;text-decoration:none}
.th .nl{font-size:calc(11px * var(--fs));color:var(--faint)}
.th.on .sw{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 6px 18px -8px var(--accent)}
.th.on .nl{color:var(--accent);font-weight:600}
.th:active .sw{transform:scale(.94)}

/* 字号 / 开关 */
.seg{display:flex;gap:0;border:1px solid var(--line);border-radius:9px;overflow:hidden;width:fit-content}
.seg button{
  border:0;background:transparent;padding:9px 20px;font-size:calc(13px * var(--fs));cursor:pointer;
  font-family:inherit;color:var(--muted);transition:.15s;border-right:1px solid var(--line)
}
.seg button:last-child{border-right:0}
.seg button.on{background:var(--accent-soft);color:var(--accent);font-weight:600}
.sw2{
  width:46px;height:26px;border-radius:14px;background:var(--line);border:0;cursor:pointer;
  position:relative;transition:.22s var(--ease);flex-shrink:0
}
.sw2 i{position:absolute;left:3px;top:3px;width:20px;height:20px;border-radius:50%;background:var(--surface);transition:.22s var(--ease);box-shadow:0 1px 3px rgba(0,0,0,.2)}
.sw2.on{background:var(--accent)}
.sw2.on i{left:23px}
.setrow{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px solid var(--line)}
.setrow:last-child{border-bottom:0;padding-bottom:0}
.setrow .lb{font-size:calc(13.5px * var(--fs));color:var(--ink)}
.setrow .sb{font-size:calc(11.5px * var(--fs));color:var(--faint);margin-top:2px}

/* ========== 书架 ========== */
.shelfhd{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:26px 0 10px}
.shelfhd h2{font-size:calc(13px * var(--fs));font-weight:600;color:var(--muted);letter-spacing:.06em}
.shelfhd .sl{font-size:calc(11.5px * var(--fs));color:var(--faint)}
.strip{display:flex;gap:10px;overflow-x:auto;padding:2px 2px 10px;scroll-snap-type:x proximity}
.strip::-webkit-scrollbar{height:6px}
.spine{
  position:relative;flex:0 0 auto;width:106px;height:138px;border-radius:5px 10px 10px 5px;
  border:1px solid var(--line);
  background:linear-gradient(155deg, color-mix(in srgb,var(--sp,var(--accent)) 26%,var(--surface)), var(--surface) 76%);
  cursor:pointer;font-family:inherit;text-align:left;padding:13px 11px 11px 15px;
  display:flex;flex-direction:column;justify-content:space-between;align-items:stretch;overflow:hidden;
  transition:.18s var(--ease);scroll-snap-align:start;color:var(--ink)
}
.spine::before{content:'';position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--sp,var(--accent));opacity:.55}
.spine:hover{transform:translateY(-3px);border-color:var(--accent)}
.spine.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.spine .bt{font-size:calc(13px * var(--fs));font-weight:600;line-height:1.34;color:color-mix(in srgb,var(--sp,var(--ink)) 62%, var(--ink));
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.spine .bn{display:block;font-size:calc(10.5px * var(--fs));color:var(--faint);margin-top:7px}
.spine .bprog{display:block;height:3px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:6px}
.spine .bprog i{display:block;height:100%;background:var(--sp,var(--accent));transition:width .4s}
.spine .seal{
  position:absolute;right:5px;top:9px;transform:rotate(-12deg);
  border:1.5px solid var(--warn);color:var(--warn);font-size:9px;line-height:1.2;
  padding:2px 3px;border-radius:3px;letter-spacing:1px;font-weight:600;opacity:.92;
  writing-mode:vertical-rl;text-orientation:upright
}
.spine.done{background:linear-gradient(155deg, var(--note-bg), var(--surface) 76%)}
.spine.done::before{background:var(--warn);opacity:.75}
.spine.add{
  align-items:center;justify-content:center;background:transparent;
  border-style:dashed;color:var(--faint);font-size:calc(12px * var(--fs));gap:2px
}
.spine.add::before{display:none}
.spine.add .pl{font-size:24px;line-height:1;font-weight:300}
.spine.add:hover{color:var(--accent);border-color:var(--accent)}

/* 书架页：书封网格 */
.bgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px;margin-top:18px}
.bcell{
  position:relative;background:var(--surface);border:1px solid var(--line);border-radius:12px;
  padding:0;overflow:hidden;cursor:pointer;font-family:inherit;text-align:left;color:var(--ink);
  transition:.18s var(--ease);display:flex;flex-direction:column;align-items:stretch;min-height:156px
}
.bcell:hover{transform:translateY(-3px);border-color:var(--accent)}
.bcell .cover{
  height:98px;background:linear-gradient(155deg, var(--sps,var(--accent-soft)), var(--surface) 78%);
  border-bottom:1px solid var(--line);padding:14px 14px 10px;position:relative;overflow:hidden
}
.bcell .cover::after{content:'';position:absolute;left:0;top:0;bottom:0;width:6px;background:var(--sp,var(--accent));opacity:.55}
.bcell .cvt{font-size:calc(14px * var(--fs));font-weight:600;line-height:1.35;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.bcell .cvn{position:absolute;right:12px;bottom:9px;font-size:calc(10.5px * var(--fs));color:var(--faint)}
.bcell .meta{padding:11px 14px 13px}
.bcell .meta .row2{display:flex;justify-content:space-between;font-size:calc(11px * var(--fs));color:var(--faint);margin-top:7px}
.bcell .bprog{height:4px;background:var(--bg);border-radius:2px;overflow:hidden}
.bcell .bprog i{display:block;height:100%;background:var(--sp,var(--accent))}
.bcell.done{border-color:var(--warn)}
.bcell.done .cover{background:linear-gradient(155deg, var(--note-bg), var(--surface) 78%)}
.bcell.done .cover::after{background:var(--warn);opacity:.8}
.bcell.cur{box-shadow:0 0 0 2px var(--accent-soft)}
.bcell .stamp{
  position:absolute;right:10px;top:10px;transform:rotate(-13deg);
  border:1.5px solid var(--warn);color:var(--warn);font-size:10px;font-weight:600;
  padding:2px 5px;border-radius:3px;letter-spacing:1.5px;background:transparent
}
/* 设置里的书架管理 */
.bkrow{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--line)}
.bkrow:last-child{border-bottom:0}
.bkname{
  flex:1;min-width:0;font-family:inherit;font-size:calc(13px * var(--fs));color:var(--ink);
  background:transparent;border:1px solid transparent;border-radius:7px;padding:6px 8px;
  transition:.14s;text-overflow:ellipsis
}
.bkname:hover{border-color:var(--line);background:var(--bg)}
.bkname:focus{outline:none;border-color:var(--accent);background:var(--surface)}
.bkinfo{font-size:calc(11.5px * var(--fs));color:var(--faint);white-space:nowrap;flex-shrink:0}
.bkdel{
  border:1px solid var(--line);background:transparent;color:var(--faint);border-radius:7px;
  padding:5px 11px;font-size:calc(12px * var(--fs));cursor:pointer;font-family:inherit;flex-shrink:0;transition:.14s
}
.bkdel:hover{color:var(--bad);border-color:var(--bad);background:var(--bad-soft)}
/* 过关记录 */.tl{margin-top:12px;border-left:1px solid var(--line);padding-left:18px;display:flex;flex-direction:column;gap:16px}
.tl .tlrow{position:relative}
.tl .tlrow::before{
  content:'';position:absolute;left:-23px;top:6px;width:9px;height:9px;border-radius:50%;
  background:var(--surface);border:2px solid var(--warn)
}
.tl .tlw{font-size:calc(13.5px * var(--fs));font-weight:600}
.tl .tld{font-size:calc(11.5px * var(--fs));color:var(--faint);margin-top:2px}

/* 过关庆祝 */
.mask{
  position:fixed;inset:0;background:rgba(12,14,12,.42);z-index:70;
  display:flex;align-items:center;justify-content:center;padding:24px;
  animation:fade .22s var(--ease)
}
.mask.off{display:none}
.celbox{
  background:var(--surface);border-radius:20px;padding:34px 26px 26px;max-width:340px;width:100%;
  text-align:center;box-shadow:0 30px 70px -30px rgba(0,0,0,.5);
  animation:pop .46s var(--ease);position:relative;overflow:hidden
}
.celbox .bigseal{
  width:88px;height:88px;margin:0 auto 18px;border-radius:50%;
  border:2.5px solid var(--warn);color:var(--warn);display:flex;align-items:center;justify-content:center;
  font-size:calc(19px * var(--fs));font-weight:600;letter-spacing:2px;transform:rotate(-8deg);
  animation:sealIn .6s .12s var(--ease) both
}
.celbox h3{font-size:calc(18px * var(--fs));font-weight:600;margin-bottom:6px}
.celbox .csub{font-size:calc(12.5px * var(--fs));color:var(--faint);line-height:1.7}
.celbox .cbook{font-size:calc(13px * var(--fs));color:var(--accent);font-weight:600;margin-top:10px}
.celbox .row{margin-top:22px;justify-content:center}
@keyframes pop{from{opacity:0;transform:scale(.9) translateY(10px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes sealIn{0%{opacity:0;transform:rotate(-8deg) scale(1.6)}60%{opacity:1;transform:rotate(-8deg) scale(.94)}100%{transform:rotate(-8deg) scale(1)}}
body[data-anim="off"] .mask,body[data-anim="off"] .celbox,body[data-anim="off"] .bigseal{animation:none}

/* ============ 登录 / 建账号 ============ */
body.authing{overflow:hidden}
body.authing header{background:transparent;box-shadow:none}
body.authing header::after{display:none}
body.authing .hd .brand{opacity:0;pointer-events:none}
body.authing main,body.authing #toast,body.authing #sbar{visibility:hidden}
#auth{
  position:fixed;inset:0;z-index:9;display:flex;align-items:center;justify-content:center;
  background:
    radial-gradient(58% 46% at 16% 6%, var(--accent-soft) 0%, transparent 64%),
    radial-gradient(46% 42% at 88% 94%, var(--accent-soft) 0%, transparent 62%),
    var(--bg);
  -webkit-app-region:drag
}
#auth .acard{
  -webkit-app-region:no-drag;
  width:354px;max-width:calc(100vw - 44px);max-height:calc(100vh - 40px);overflow:auto;
  background:var(--surface);border:1px solid var(--line);border-radius:20px;
  padding:32px 30px 24px;box-shadow:0 26px 60px -34px rgba(0,0,0,.5);text-align:center;
  animation:cardIn .52s var(--ease) both
}
@keyframes cardIn{from{opacity:0;transform:translateY(16px) scale(.982)}to{opacity:1;transform:none}}
body[data-anim="off"] #auth .acard{animation:none}
.amk{
  width:46px;height:46px;border-radius:14px;background:var(--accent);color:var(--on-accent);
  font-size:21px;font-weight:600;display:flex;align-items:center;justify-content:center;
  margin:0 auto 14px;box-shadow:0 12px 26px -14px var(--accent)
}
#auth h1{font-size:calc(19px * var(--fs));font-weight:600;letter-spacing:2px}
.asub{font-size:calc(12.5px * var(--fs));color:var(--faint);margin-top:6px;line-height:1.6}
.apick{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:22px 0 14px}
.au{
  border:1px solid var(--line);background:var(--bg);border-radius:12px;padding:7px 12px 7px 8px;
  display:flex;align-items:center;gap:8px;cursor:pointer;font-family:inherit;color:var(--muted);
  font-size:calc(12.5px * var(--fs));transition:.15s var(--ease)
}
.au i{
  position:relative;width:21px;height:21px;border-radius:6px;color:#fff;font-style:normal;font-size:11px;font-weight:600;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden
}
.au i img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.amk{position:relative;overflow:hidden}
.amk img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.au:hover{border-color:var(--faint)}
.au.on{border-color:var(--accent);color:var(--ink);background:var(--accent-soft)}
.ain{
  width:100%;height:42px;border:1px solid var(--line);background:var(--bg);border-radius:11px;
  padding:0 14px;font-size:calc(13.5px * var(--fs));font-family:inherit;color:var(--ink);outline:none;
  margin-top:10px;transition:border-color .15s,background .15s
}
.ain::placeholder{color:var(--faint)}
.ain:focus{border-color:var(--accent);background:var(--surface)}
.arem{display:flex;align-items:center;gap:7px;font-size:calc(12px * var(--fs));color:var(--faint);margin:13px 2px 0;cursor:pointer;text-align:left}
.arem input{accent-color:var(--accent);width:13px;height:13px;cursor:pointer}
.abtn{width:100%;margin-top:16px}
.aerr{font-size:calc(12px * var(--fs));color:var(--bad);min-height:18px;margin-top:8px}
.afoot{margin-top:2px}
.alink{
  border:0;background:none;color:var(--faint);font-size:calc(12px * var(--fs));cursor:pointer;
  font-family:inherit;text-decoration:underline;text-underline-offset:3px;padding:6px;transition:color .14s
}
.alink:hover{color:var(--accent)}
#perNote .alink+.alink{margin-left:8px}
#perNote{padding-top:2px}
.anew-t{font-size:calc(13px * var(--fs));color:var(--muted);margin:20px 0 2px}
.anote{font-size:calc(11px * var(--fs));color:var(--faint);margin-top:16px;line-height:1.75}
/* 设置页的账号卡 */
.acctrow{display:flex;align-items:center;gap:12px;margin-top:14px}
.avn{
  position:relative;width:46px;height:46px;border-radius:14px;color:#fff;font-size:17px;font-weight:600;
  flex-shrink:0;display:flex;align-items:center;justify-content:center;border:0;padding:0;overflow:hidden;
  cursor:pointer;font-family:inherit;transition:.18s var(--ease)
}
.avn img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.avn:hover{transform:translateY(-1px)}
.avn::after{
  content:'换';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.45);color:#fff;font-size:11px;font-weight:400;opacity:0;transition:.16s
}
.avn:hover::after{opacity:1}
.acctmeta{flex:1;min-width:0;text-align:left}
.acctmeta b{font-size:calc(13.5px * var(--fs));font-weight:600;display:block}
.acctmeta span{font-size:calc(11.5px * var(--fs));color:var(--faint)}
.pwbox{margin-top:14px;display:none}
.pwbox.on{display:block}
</style>
</head>
<body>

<header id="appbar">
  <div class="wctl" id="wctl">
    <button data-w="min" title="最小化" aria-label="最小化"><svg viewBox="0 0 12 12"><path d="M2.4 6h7.2"/></svg></button>
    <button data-w="max" title="最大化" aria-label="最大化">
      <svg class="i-max" viewBox="0 0 12 12"><rect x="2.3" y="2.3" width="7.4" height="7.4" rx="1.2"/></svg>
      <svg class="i-restore" viewBox="0 0 12 12"><rect x="1.6" y="3.4" width="6.4" height="6.4" rx="1"/><path d="M3.9 3.4V2.2h6.1v6.1H8.8"/></svg>
    </button>
    <button data-w="full" title="全屏（盖住任务栏）" aria-label="全屏">
      <svg class="i-full" viewBox="0 0 12 12"><path d="M2.4 4.6V2.4h2.2M7.4 2.4h2.2v2.2M9.6 7.4v2.2H7.4M4.6 9.6H2.4V7.4"/></svg>
      <svg class="i-exit" viewBox="0 0 12 12"><path d="M2.4 4.6V2.4h2.2M7.4 2.4h2.2v2.2M9.6 7.4v2.2H7.4M4.6 9.6H2.4V7.4"/><rect x="4.7" y="4.7" width="2.6" height="2.6" rx=".5"/></svg>
    </button>
    <button data-w="close" title="关闭" aria-label="关闭"><svg viewBox="0 0 12 12"><path d="M2.6 2.6l6.8 6.8M9.4 2.6L2.6 9.4"/></svg></button>
  </div>
  <div class="wrap hd">
    <button class="back" id="backBtn" aria-label="返回"><svg viewBox="0 0 16 16"><path d="M9.8 3.2L5 8l4.8 4.8"/></svg></button>
    <div class="brand">
      <span class="mk">词</span>
      <span class="tx">词迹</span>
      <span class="ds">看英文，想中文</span>
    </div>
    <div class="whoWrap" id="whoWrap">
      <button class="who" id="whoBtn" aria-label="账号">
        <span class="av" id="whoAv">·</span>
        <span class="nm" id="whoNm">账号</span>
        <svg class="cv" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1.2l4 3.6 4-3.6"/></svg>
      </button>
      <div class="wpop" id="whoPop">
        <div class="hd2"><b id="whoPopName">账号</b><span>这台电脑上，只属于你</span></div>
        <button data-act="set"><svg viewBox="0 0 24 24"><path d="M4 7h10"/><path d="M18 7h2"/><circle cx="16" cy="7" r="2"/><path d="M4 17h4"/><path d="M12 17h8"/><circle cx="10" cy="17" r="2"/></svg>设置</button>
        <button data-act="switch"><svg viewBox="0 0 24 24"><path d="M4 8h13l-3-3"/><path d="M20 16H7l3 3"/></svg>切换账号</button>
        <div class="sep"></div>
        <button data-act="out"><svg viewBox="0 0 24 24"><path d="M14 5H6v14h8"/><path d="M17 12H10"/><path d="M17 12l-3-3"/><path d="M17 12l-3 3"/></svg>退出登录</button>
      </div>
    </div>
  </div>
</header>

<main class="wrap">
  <section id="view-home"></section>
  <section id="view-shelf" style="display:none"></section>
  <section id="view-read" style="display:none"></section>
  <section id="view-write" style="display:none"></section>
  <section id="view-wrong" style="display:none"></section>

  <section id="view-set" style="display:none">
    <div class="pagehd"><button class="pback" data-back="1" title="返回上一级"><svg viewBox="0 0 16 16"><path d="M9.8 3.2L5 8l4.8 4.8"/></svg>返回</button><h1>设置</h1></div>

    <div class="box" id="acctBox" style="margin-top:18px;display:none"></div>

    <div class="box" id="dataBox" style="margin-top:18px">
      <h3>账号数据</h3>
      <div class="desc">都写在这个账号自己的文件里，换账号互不干扰；已学过的不会因为你改设置而重来。</div>
      <div id="dataRows" style="margin-top:10px"></div>
      <div class="databar"><i id="dataBar" style="width:0"></i></div>
    </div>

    <div class="box" style="margin-top:18px">
      <h3>外观</h3>
      <div class="desc">配色、字号、动效。改了立刻生效，下次打开还是这个。</div>
      <div class="themes" id="themes">
        <button class="th" data-t="paper"><span class="sw" style="background:#FBFAF7"><i style="background:#FFFFFF"></i><u style="background:#1F6B4F"></u></span><span class="nl">纸白</span></button>
        <button class="th" data-t="ink"><span class="sw" style="background:#131519"><i style="background:#1B1E23"></i><u style="background:#74C3A0"></u></span><span class="nl">墨黑</span></button>
        <button class="th" data-t="forest"><span class="sw" style="background:#F3F7F3"><i style="background:#FFFFFF"></i><u style="background:#2C6B4A"></u></span><span class="nl">森绿</span></button>
        <button class="th" data-t="ocean"><span class="sw" style="background:#F4F6FB"><i style="background:#FFFFFF"></i><u style="background:#2B5C8E"></u></span><span class="nl">靛蓝</span></button>
        <button class="th" data-t="clay"><span class="sw" style="background:#FDF7F1"><i style="background:#FFFFFF"></i><u style="background:#9C5230"></u></span><span class="nl">暖陶</span></button>
        <button class="th" data-t="ai" id="thAI" style="display:none"><span class="sw"><i></i><u></u></span><span class="nl">今日</span></button>
      </div>
      <div class="setrow" style="margin-top:16px;border-top:1px solid var(--line)">
        <div><div class="lb">字号</div><div class="sb">只影响文字，不改布局</div></div>
        <div class="seg" id="fsSeg">
          <button data-f="0.92">小</button><button data-f="1">中</button><button data-f="1.14">大</button>
        </div>
      </div>
      <div class="setrow">
        <div><div class="lb">动效</div><div class="sb">翻卡、切页、按钮反馈</div></div>
        <button class="sw2" id="animSw" aria-label="动效开关"><i></i></button>
      </div>
    </div>

    <div class="box" id="palBox">
      <h3>今日配色 · AI</h3>
      <div class="desc">让 AI 先看今天的样子再配色：日期、节气、季节、天气，再加上你最近在背的词是什么气质。头像主色也会算进去。只花一次对话的钱，配完就存在本机。</div>
      <div class="palrow">
        <div class="pv" id="palSw"></div>
        <div class="pi">
          <b id="palName">跟随主题</b>
          <span id="palNote">还没配过</span>
        </div>
      </div>
      <div class="palacts">
        <button class="btn primary sm" id="palAI">按今天配一套</button>
        <button class="btn ghost sm" id="palAvatar">按头像配</button>
        <button class="btn ghost sm" id="palRandom">随手一套</button>
        <button class="btn ghost sm" id="palReset">还原</button>
      </div>
      <div class="palctx" id="palCtx"></div>
      <div class="setrow" style="margin-top:16px">
        <div><div class="lb">你所在的城市</div><div class="sb">留空就按网络自动定位；填了按这个城市取天气，随时可改</div></div>
      </div>
      <div class="field" style="margin-top:10px;margin-bottom:0">
        <input type="text" id="cityInput" maxlength="24" placeholder="例如 杭州（留空自动定位）">
      </div>
    </div>

    <div class="box" id="perBox">
      <h3>一本书一组</h3>
      <div class="desc" id="pageDesc" style="margin-top:10px"></div>
      <div class="chips" id="chips">
        <button class="chip" data-n="20">20</button>
        <button class="chip" data-n="36">36</button>
        <button class="chip" data-n="50">50</button>
        <button class="chip" data-n="100">100</button>
      </div>
      <div class="field" style="margin-top:14px;margin-bottom:0">
        <input type="number" id="batchInput" min="5" max="500" step="5" placeholder="或自己填一个数（5–500）">
      </div>
      <div class="note" id="perNote"></div>
    </div>

    <div class="box">
      <h3>默写快捷键</h3>
      <div class="desc">只在全屏时接管。点按钮，再按一个键就能改；按 Esc 取消。判分键按一次判分、判完再按一次进入下一个；跳过键用来直接过掉不会的词。</div>
      <div class="setrow" style="margin-top:14px">
        <div><div class="lb">判分 / 下一个</div><div class="sb">写完按它判分，再按它进入下一个词</div></div>
        <button class="keybtn" id="keyJudge"></button>
      </div>
      <div class="setrow">
        <div><div class="lb">不会，跳过</div><div class="sb">建议用逗号、斜杠这类冷门键，避开中英文输入法都会占用的句号</div></div>
        <button class="keybtn" id="keySkip"></button>
      </div>
      <div class="row" style="justify-content:flex-start;margin-top:6px">
        <button class="btn ghost sm" id="keyReset">恢复默认</button>
        <span class="kbd" style="margin:0;align-self:center" id="keyHint"></span>
      </div>
    </div>

    <div class="box">
      <h3>AI 判分</h3>
      <div class="desc">不填也能用，只是判得严格：意思对但说法不同，本地规则认不出来。填了之后，拿不准的答案交给 AI 复核。</div>
      <div class="field">
        <label>API Key</label>
        <input type="password" id="keyInput" placeholder="sk-...">
      </div>
      <div class="field">
        <label>接口地址</label>
        <div class="chips" id="apiPresets" style="margin:0 0 10px"></div>
        <input type="text" id="urlInput" placeholder="填到 /chat/completions；只填 https://open.bigmodel.cn/api/paas/v4 也行，会自动补全">
      </div>
      <div class="field" style="margin-bottom:14px">
        <label>模型名</label>
        <input type="text" id="modelInput" placeholder="deepseek-chat">
      </div>
      <div class="row" style="justify-content:flex-start;margin-top:0">
        <button class="btn primary" id="saveKey">保存</button>
        <button class="btn ghost" id="testKey">测试连接</button>
      </div>
      <div class="note" id="testResult"></div>
      <div class="note" style="margin-top:12px" id="proxyNote"></div>
    </div>

    <div class="box" id="boxImport">
      <h3>书架 · 导入新书</h3>
      <div class="desc">CSV 表头：<b>word,meanings,phonetic,note</b>。义项用 <b>|</b> 分隔，同一义项的近义说法用 <b>、</b> 分隔。每导入一次，书架上就多一本，原来那本连进度一起原地保留。</div>
      <div class="field">
        <label>书名</label>
        <input type="text" id="bookTitle" placeholder="留空就用文件名，比如：六级核心词 800">
      </div>
      <input type="file" id="fileInput" accept=".csv,.txt" class="file">
      <div class="field" style="margin-top:16px">
        <label>或者直接粘贴</label>
        <textarea id="pasteArea" placeholder="word,meanings,phonetic,note&#10;abandon,&quot;v.放弃、抛弃|v.遗弃&quot;,,&#10;" style="min-height:100px"></textarea>
      </div>
      <button class="btn primary" id="doImport">导入为新书</button>
      <div id="importReport" class="note"></div>
    </div>

    <div class="box">
      <h3>书架管理</h3>
      <div class="desc">改名、删书。删掉的书连同它的进度一起消失，删了就找不回来。</div>
      <div id="bookList" style="margin-top:6px"></div>
    </div>

    <div class="box">
      <h3>数据</h3>
      <div class="desc">桌面版把进度写成硬盘上的一个文件，跟程序放在一起。关掉、重启、换浏览器都不影响。想换电脑，拷「数据」文件夹或导出一份备份。</div>
      <div class="row" style="justify-content:flex-start;margin-top:0">
        <button class="btn ghost" id="exportBtn">导出备份</button>
        <button class="btn ghost" id="restoreBtn">恢复备份</button>
        <button class="btn ghost" id="openDataBtn" style="display:none">打开数据文件夹</button>
        <button class="btn ghost" id="resetBtn">清空进度</button>
      </div>
      <input type="file" id="restoreInput" accept=".json" style="display:none">
      <div class="note" id="dataInfo"></div>
    </div>
  </section>
</main>

<div class="toast" id="toast"></div>

<script>
/* ============ 内置示例词库 ============ */
const DEMO = [
{w:"abandon",p:"/əˈbændən/",s:[["v.","放弃、抛弃"],["v.","遗弃、离弃"]],
 e:{t:"源自古法语 a bandon，字面是「置于他人支配之下」——把东西交出去，不再管。ban 在古法语里是「支配权」，所以 abandon 的本义不是「走开」，而是「交出控制权」。",r:[["a","在、向"],["bandon","支配权"]],src:"etymonline",c:"high"},
 m:"不是「走」，是「交出去」。把你的权利交出去，就是放弃。"},
{w:"address",p:"/əˈdres/",s:[["n.","地址、住址"],["v.","处理、应对"],["v.","向……讲话、致辞"]],
 e:{t:"源自拉丁俗语 ad-directiare，ad 表方向，directus 意为「取直、引导」，本义是「把东西摆正、对准」。对准某人的方向说话，就是致辞；把乱事摆正，就是处理。",r:[["ad-","朝向"],["directus","取直、引导"]],src:"etymonline",c:"high"},
 m:"一个动作「对准」，对准人=讲话，对准事=处理，对准位置=地址。"},
{w:"salary",p:"/ˈsæləri/",s:[["n.","薪水、工资"]],
 e:{t:"源自拉丁 salarium，与 sal（盐）相关。罗马士兵领的津贴被认为用于买盐，故称「盐钱」。不过学界对「士兵买盐」这一说法仍有争议，较稳妥的理解是：它与盐这项专卖物资的配给费用有关。",r:[["sal","盐"],["-arium","相关之物"]],src:"etymonline",c:"medium"},
 m:"盐在古代是硬通货。「盐钱」演变成工资，salary 和 salt 同根。"},
{w:"disaster",p:"/dɪˈzɑːstə/",s:[["n.","灾难、灾祸"],["n.","彻底的失败"]],
 e:{t:"来自意大利语 disastro，dis-（坏、偏离）+ astro（星）。古人认为星象错位会招致灾祸，一件事「星位不对」就是大难临头。",r:[["dis-","偏离、坏"],["astro","星辰"]],src:"etymonline",c:"high"},
 m:"星星位置不对 = 大祸临头。dis- 加 aster（星），和你熟悉的 astronomy 同根。"},
{w:"quarantine",p:"/ˈkwɒrəntiːn/",s:[["n.","隔离、检疫期"],["v.","对……进行隔离"]],
 e:{t:"源自威尼斯方言 quaranta giorni，意为「四十天」。十四世纪黑死病肆虐，威尼斯要求外来船只停泊四十天才能卸货，这个词就从此固定下来。",r:[["quaranta","四十"],["giorni","天"]],src:"etymonline",c:"high"},
 m:"四十天。记住「四十」，就记住了隔离的来历。"},
{w:"vaccine",p:"/ˈvæksiːn/",s:[["n.","疫苗"]],
 e:{t:"源自拉丁 vacca（牛）。十八世纪末琴纳发现挤奶女工感染牛痘后不会得天花，便用牛痘接种预防天花，疫苗因此得名「牛的东西」。",r:[["vacca","牛"],["-ine","形容词后缀"]],src:"etymonline",c:"high"},
 m:"疫苗的本义是「牛的」。因为第一支疫苗来自牛痘。"},
{w:"mortgage",p:"/ˈmɔːɡɪdʒ/",s:[["n.","抵押、按揭"],["v.","抵押"]],
 e:{t:"源自古法语，mort（死）+ gage（质押）。契约在债务清偿时「死去」，或在违约时彻底归债权人所有——无论哪种解释，核心都是「会死的契」。",r:[["mort","死"],["gage","质押"]],src:"etymonline",c:"high"},
 m:"死契。mort 见 mortal（会死的），gage 见 engage。一看到 mort 就该想到死。"},
{w:"candidate",p:"/ˈkændɪdət/",s:[["n.","候选人、应试者"]],
 e:{t:"源自拉丁 candidatus，意为「穿白袍的人」。古罗马竞选公职者要穿漂白的托加袍以示清白，于是「穿白的」成了候选人的代称。",r:[["candidus","雪白的"],["-atus","人"]],src:"etymonline",c:"high"},
 m:"古罗马竞选要穿白袍。candid（坦白的）也是同源——白，就是干净。"},
{w:"sabotage",p:"/ˈsæbətɑːʒ/",s:[["n.","蓄意破坏、怠工"],["v.","破坏、阻挠"]],
 e:{t:"源自法语 saboter，字面是「用木鞋踩」。sabot 指农民穿的木鞋，一种说法是工人把木鞋踢进机器使其停转，另一种是踩踏庄稼以示抗议，后来泛指蓄意破坏。",r:[["sabot","木鞋"],["-age","行为"]],src:"etymonline",c:"high"},
 m:"木鞋踩机器。记住 sabot＝木鞋，破坏就有了画面。"},
{w:"trivial",p:"/ˈtrɪviəl/",s:[["adj.","琐碎的、不重要的"],["adj.","平凡的"]],
 e:{t:"源自拉丁 trivium，tri（三）+ via（路），指三岔路口。路口是闲人聚集、说闲话的地方，路口的话题自然被视为浅薄无聊，于是 trivium 演变成「琐碎」。",r:[["tri-","三"],["via","路"]],src:"etymonline",c:"high"},
 m:"三岔路口聊的都是闲话，所以琐碎。tri 是「三」，via 是「路」。"},
{w:"companion",p:"/kəmˈpæniən/",s:[["n.","同伴、伴侣"],["n.","（书的）指南、手册"]],
 e:{t:"源自拉丁 com（共同）+ panis（面包），字面是「一起吃面包的人」。同桌吃饭的人，就是同伴。",r:[["com-","共同"],["panis","面包"]],src:"etymonline",c:"high"},
 m:"一起分面包的人才是同伴。companion 里有 pan（面包），和 company 同源。"},
{w:"calculate",p:"/ˈkælkjuleɪt/",s:[["v.","计算、核算"],["v.","推测、预计"]],
 e:{t:"源自拉丁 calculus，意为「小石子」。古人用小石子计数、摆算，就像算盘。英语里 calculus 至今仍指微积分和牙结石——都是「小石头」。",r:[["calculus","小石子"],["-ate","动词后缀"]],src:"etymonline",c:"high"},
 m:"用石子算数。calculus 是「小石子」，结石也叫 calculus，形状上的联想。"},
{w:"window",p:"/ˈwɪndəʊ/",s:[["n.","窗户、窗口"]],
 e:{t:"源自古诺斯语 vindauga，vindr（风）+ auga（眼），字面是「风之眼」。北欧房屋在墙上开洞排烟透光，那个洞就是房子的「眼睛」。",r:[["vindr","风"],["auga","眼"]],src:"etymonline",c:"high"},
 m:"风之眼。屋子睁开的眼睛，用来透风。"},
