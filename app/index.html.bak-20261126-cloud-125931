       页面因此总带主题的颜色，不会变成一片灰。 */
    const tint = hsl(h1, dark ? .40 : .30, dark ? .10 : .966);
    bg = mixc(bg, tint, .6);
    setPalette({
      name: String(j.name || '今日色').slice(0, 6),
      note: String(j.note || '').slice(0, 40),
      by: 'AI · ' + ctx.term,
      base: {bg, ink: '', accent: a1, accent2: a2, accent3: a3, dark}
    });
  }catch(e){
    toast('没配成：' + e.message);
  }
  clearInterval(tick);
  if(btn){
    btn.classList.remove('busy');
    btn.textContent = state.cfg.key ? '按今天配一套' : '按今天配（要先接 AI）';
  }
}
