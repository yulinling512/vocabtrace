/* 桌面版开机：先问本地服务要数据，硬盘上的比浏览器里的新就采纳 */
async function pullDisk(){
  try{
    const r = await fetch('/api/state?uid=' + encodeURIComponent(ACCT.id), {cache:'no-store'});
    const d = await r.json();
    if(!d || d.empty) return;
    const local = JSON.parse(localStorage.getItem(LS.meta) || '{}');
    const lsSes = JSON.parse(localStorage.getItem(LS.ses) || 'null');
    const lsProg = JSON.parse(localStorage.getItem(LS.prog) || '{}');
    /* 进度分：背到第几个 + 已过关词数。谁的记录更靠前就听谁的，
       防止浏览器缓存里的旧快照把硬盘上更新的记录冲掉 */
    const score = (ses, prog) =>
      ((ses && ses.index) ? ses.index : 0) +
      Object.keys(prog || {}).filter(k => (prog[k] || {}).doneAt).length;
    const dScore = score(d.session, d.prog);
    const lScore = score(lsSes, lsProg);
    const keepLocal = lScore > dScore || (lScore === dScore && (local.savedAt || 0) > (d.savedAt || 0));
    if((d.savedAt || 0) <= (local.savedAt || 0) && !keepLocal) return;
    if(Array.isArray(d.books) && d.books.length){
      localStorage.setItem(LS.books, JSON.stringify(d.books));
      localStorage.setItem(LS.active, d.activeId || d.books[0].id);
    }
    /* 旧格式（只有一份词库）也接住；词卡内容永远以硬盘为准（新补的词源、记法都在这） */
    if(d.words) localStorage.setItem(LS.deck, JSON.stringify(d.words));
    if(d.cfg) localStorage.setItem(LS.cfg, JSON.stringify(d.cfg));
    if(d.daily && typeof d.daily === 'object'){
      const ld = JSON.parse(localStorage.getItem(LS.daily) || '{}');
      Object.keys(d.daily).forEach(k=>{
        const a = d.daily[k] || {}, b = ld[k] || {};
        ld[k] = {read:Math.max(a.read||0,b.read||0), write:Math.max(a.write||0,b.write||0)};
      });
      localStorage.setItem(LS.daily, JSON.stringify(ld));
    }
    /* 学习记录：只在本地更靠前时才保留本地 */
    if(!keepLocal){
      if(d.prog) localStorage.setItem(LS.prog, JSON.stringify(d.prog || {}));
      localStorage.setItem(LS.ses, JSON.stringify(d.session || null));
    }
    localStorage.setItem(LS.meta, JSON.stringify({savedAt: Math.max(d.savedAt || 0, local.savedAt || 0)}));
  }catch(e){ /* 没有服务就直接用浏览器里的 */ }
}

