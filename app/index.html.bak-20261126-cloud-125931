/* ============ 设置 ============ */
let keyCapture = null;
function paintKeyCfg(){
  const K = keyCfg();
  const jb = $('keyJudge'), sb = $('keySkip');
  if(jb){ jb.textContent = keyCapture==='judge' ? '请按一个键…' : keyLabel(K.judge);
          jb.classList.toggle('listening', keyCapture==='judge'); }
  if(sb){ sb.textContent = keyCapture==='skip' ? '请按一个键…' : keyLabel(K.skip);
          sb.classList.toggle('listening', keyCapture==='skip'); }
  const hint = $('keyHint');
  if(hint) hint.textContent = '当前：判分 ' + keyLabel(K.judge) + ' · 跳过 ' + keyLabel(K.skip);
}
document.addEventListener('keydown', e=>{
  if(!keyCapture) return;
  e.preventDefault(); e.stopImmediatePropagation();
  if(e.code === 'Escape'){ keyCapture=null; paintKeyCfg(); toast('取消'); return; }
  if(e.ctrlKey || e.altKey || e.metaKey || KEY_BAD.indexOf(e.code) >= 0){
    toast('这个键不合适，换一个'); return;
  }
  const K = keyCfg();
  if((keyCapture==='judge' && e.code===K.skip) || (keyCapture==='skip' && e.code===K.judge)){
    toast('两个快捷键不能一样'); return;
  }
  const which = keyCapture; keyCapture = null;
  state.cfg.keys[which] = e.code;
  saveCfg(); paintKeyCfg();
  toast((which==='judge'?'判分键 → ':'跳过键 → ') + keyLabel(e.code));
}, true);

