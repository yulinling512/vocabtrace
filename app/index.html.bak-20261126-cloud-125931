/* ============ 判分 ============ */
const PUNCT = /[\s\u3000，,。.、；;：:！!？?"'“”‘’（）()【】\[\]…~·\/\\]/g;
const norm = s => (s||'').toLowerCase().replace(PUNCT,'').replace(/[的了]$/,'').trim();
/* 义项常写成「从事（in）」，判分前把括注剥掉，不然 in 会被当成字来比 */
const stripNote = s => (s||'').replace(/[（(][^）)]*[）)]/g,'');

/* 同义、异形的写法先归成一族。
   两字词只差一个字就翻脸，是误判的主要来源——「雇佣」对「雇用」原本只能拿 24 分 */
const SYN_GROUPS = [
  ['雇佣','雇用','聘用','聘请','聘任','录用'],
  ['从事','从业','投身','做活','经营'],
  ['订婚','定婚','定亲','婚约'],
  ['吸引','招引','引来','吸引人','迷人'],
  ['参加','参与','加入','出席','到场'],
  ['放弃','抛弃','舍弃','丢弃','撇下'],
  ['确定','决定','断定','判定','确认'],
  ['提高','提升','增高','上涨'],
  ['减少','降低','削减','下降'],
  ['巨大','庞大','宏大','硕大'],
  ['迅速','快速','飞快','捷速'],
  ['困难','艰难','费劲','吃力'],
  ['重要','要紧','关键','重大'],
  ['明显','显著','鲜明','清楚'],
  ['承受','忍受','忍耐','经受'],
  ['责备','责怪','指责','批评'],
  ['依靠','依赖','仰仗','凭借'],
  ['阻止','制止','阻挡','拦阻'],
  ['保护','维护','守护','保卫'],
  ['预测','预料','预言','预计'],
  ['证明','证实','论证','表明'],
  ['承认','认可','供认','认同'],
  ['忽视','忽略','无视','轻视'],
  ['获得','得到','取得','赢得'],
  ['提供','给予','供给','供应'],
  ['消耗','耗费','耗尽','耗掉'],
  ['积累','累积','积攒','堆积'],
  ['持续','连续','延续','不断'],
  ['严重','恶劣','严峻','厉害'],
  ['满意','满足','称心','如意'],
  ['导致','引起','招致','造成'],
  ['拒绝','回绝','谢绝','推辞'],
  ['允许','准许','许可','让'],
  ['建立','创立','设立','组建'],
  ['改变','更改','变动','改动'],
  ['选择','挑选','抉择','选取'],
  ['适合','适宜','合适','恰当'],
  ['安顿','安排','安置','布置'],
  ['揭露','揭示','暴露','披露'],
  ['强调','着重','突出','重申'],
  ['尴尬','难堪','窘迫','难看'],
  ['疲惫','疲劳','疲乏','劳累'],
  ['谨慎','小心','慎重','仔细'],
  ['奢侈','奢华','豪华','铺张'],
  ['利润','收益','盈利','赚头']
];
const SYN_OF = (()=>{
  const m = Object.create(null);
  for(const g of SYN_GROUPS) for(const w of g){
    if(!m[w]) m[w] = new Set([w]);
    for(const x of g) m[w].add(x);
  }
  return m;
})();
function variants(t){ const s = SYN_OF[t]; return s ? [...s] : [t]; }

function jaccard(a,b){
  if(!a||!b) return 0;
  const A=new Set(a.split('')), B=new Set(b.split(''));
  let inter=0; A.forEach(c=>{ if(B.has(c)) inter++; });
  return inter/(A.size+B.size-inter);
}
function baseMatch(u,k){
  if(!u || !k) return 0;
  if(u === k) return 1;
  if(u.includes(k) || k.includes(u)){
    const r = Math.min(u.length,k.length)/Math.max(u.length,k.length);
    return 0.62 + 0.38*r;
  }
  let s = jaccard(u,k)*0.72;
  /* 两个字里对一个字，多半是同一个意思的另一种写法，先抬到“沾边”，不至于判死 */
  if(u.length >= 2 && k.length >= 2){
    const sh = [...new Set(u)].filter(c=>k.includes(c)).length;
    const r = sh / Math.max(u.length, k.length);
    if(r >= 0.5) s = Math.max(s, 0.58 + 0.28*r);
  }
  return s;
}
function matchOne(user, accept){
  const u = norm(stripNote(user)), k0 = norm(stripNote(accept));
  if(!u || !k0) return 0;
  let best = 0;
  for(const k of variants(k0))
    for(const uu of variants(u)){
      const s = baseMatch(uu, k);
      if(s > best) best = s;
    }
  return best;
}
function localJudge(answer, senses){
  let best = 0, hit = null;
  for(const s of senses){
    for(const a of (s.meaning || '').split(/[、,，;；\/]/)){
      if(!a) continue;
      const sc = matchOne(answer, a);
      if(sc > best){ best = sc; hit = s; }
    }
  }
  return {score:Math.round(best*100), sense:hit};
}
/* 接口报错翻成人话，别让人盯着一行 HTTP 429 猜 */
function aiErrText(e){
  const m = (e && e.message) || '调用失败';
  if(/\b429\b/.test(m)) return '接口返回 429：请求过于频繁，或这个模型的额度已经用完';
  if(/\b401\b|\b403\b/.test(m)) return m + '：密钥不对，或这个模型没开权限';
  if(/\b404\b/.test(m)) return m + '：模型名在服务商那边不存在';
  if(/timeout|Failed to fetch|network|ECONN|ENOTFOUND/i.test(m)) return m + '：网络没通，或代理没起来';
  return m;
}
async function aiJudge(word, senses, answer){
  const c = state.cfg;
  if(!c.key) return null;
  const std = senses.map(s=>(s.pos||'')+s.meaning).join('；');
  const res = await fetch(apiUrl(), {
    method:'POST',
    headers: apiHeaders(c.key),
    body: JSON.stringify({
      model: c.model || 'deepseek-chat',
      temperature: 0,
      messages: [
        {role:'system', content:'你是英语词汇判分员。判断用户写的中文释义是否与标准释义语义相符。只输出 JSON，不要任何其他文字。'},
        {role:'user', content:`单词：${word}\n标准释义：${std}\n用户答案：${answer}\n\n判断用户答案是否抓住了该词的任一正确含义（同义词、近义表述、口语化说法都算对；只要意思对就算对，不要求字面一致）。\n输出：{"score":0到100的整数,"verdict":"correct或partial或wrong","comment":"不超过25字的中文点评，指出对在哪或缺什么"}`}
      ],
      response_format:{type:'json_object'}
    })
  });
  if(!res.ok) throw new Error('HTTP '+res.status);
  const data = await res.json();
  return JSON.parse(data.choices[0].message.content);
}

