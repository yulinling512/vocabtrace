let toastTimer;
function toast(msg){
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(()=>t.classList.remove('show'), 2200);
}

/* 数字往上跳，比直接甩一个结果更有「算出来」的感觉 */
function countTo(el, to, dur){
  if(!el) return;
  to = Math.round(to || 0);
  if(document.body.dataset.anim === 'off'){ el.textContent = to; return; }
  const t0 = performance.now(), from = 0, ms = dur || 700;
  const tick = t => {
    const k = Math.min(1, (t - t0) / ms);
    const e = 1 - Math.pow(1 - k, 3);
    el.textContent = Math.round(from + (to - from) * e);
    if(k < 1) requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
}
/* 过关时撒一把纸屑 */
function confetti(n){
  if(document.body.dataset.anim === 'off') return;
  const box = document.createElement('div');
  box.className = 'confetti';
  const p = PAL || paletteFromCSS();
  const cols = [p.accent, p.accent2, p.accent3, p.accent4, p.warn];
  for(let i=0;i<(n||52);i++){
    const s = document.createElement('i');
    s.style.left = (Math.random()*100) + '%';
    s.style.background = cols[i % cols.length];
    s.style.animationDelay = (Math.random()*.55) + 's';
    s.style.animationDuration = (1.7 + Math.random()*1.3) + 's';
    s.style.setProperty('--x', ((Math.random()*2-1)*90).toFixed(0) + 'px');
    s.style.setProperty('--r', ((Math.random()*720-360)|0) + 'deg');
    if(Math.random() > .6) s.style.borderRadius = '50%';
    box.appendChild(s);
  }
  document.body.appendChild(box);
  setTimeout(()=>box.remove(), 3600);
}
function renderStats(){
  /* 顶栏不再挂进度（首页书卡已有），这里只兜底，避免老代码调用报错 */
  const p = $('prog'), c = $('cnt');
  if(!p && !c) return;
  const total = state.words.length;
  const done = state.words.filter(x=>(state.prog[x.id]||{}).level>=3).length;
  if(c) c.textContent = total ? done+' / '+total : '—';
  if(p) p.style.width = total ? (done/total*100)+'%' : '0%';
}

/* ============ 书 ============ */
function bookStats(b){
  b = b || curBook();
  const total = b.words.length;
  let done = 0;
  b.words.forEach(w=>{
    const p = b.prog[w.id];
    if(p && p.pass) done++;          /* 背过 + 默过，才算这一页真的走完 */
  });
  return {total, done, pct: total ? Math.round(done/total*100) : 0};
}
function fmtDate(t){
  const d = new Date(t||Date.now());
  return (d.getMonth()+1) + ' 月 ' + d.getDate() + ' 日';
}
function switchBook(id){
  if(id === state.activeId) return;
  const b = state.books.find(x=>x.id===id);
  if(!b) return;
  state.activeId = id;
  state.wq = []; state.wi = 0; state.revealed = false;
  saveBooks(); renderStats(); switchView('home');
  toast('已切到《' + b.title + '》');
}

