/* 全书的词都过了（背过 or 掌握），就盖一个「已过关」章，只盖一次 */
function checkBookDone(){
  const b = curBook();
  if(b === EMPTY_BOOK) return false;
  const st = bookStats(b);
  if(st.total && st.done >= st.total && !b.doneAt){
    b.doneAt = Date.now();
    saveBooks();
    renderStats();
    setTimeout(()=>showCelebrate(b), 460);
    return true;
  }
  return false;
}
