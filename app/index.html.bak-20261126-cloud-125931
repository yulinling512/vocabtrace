body[data-anim="off"] *,body[data-anim="off"] *::before,body[data-anim="off"] *::after{
  animation:none!important;transition:none!important
}

/* ========== 词卡 v2 ========== */
.card{box-shadow:var(--card-shadow);padding:38px 30px 32px;min-height:340px;transition:box-shadow .3s var(--ease);overflow:hidden}
