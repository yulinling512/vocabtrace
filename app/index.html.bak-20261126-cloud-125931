    const j = await r.json().catch(()=>({ok:false, msg:'本地服务没响应'}));
    if(!j.ok) throw new Error(j.msg || '存不进去');
    ACCT.hasAvatar = true;
    ACCT.avatarAt = j.v;
    ACCT.colors = (j.colors && j.colors.length) ? j.colors : colors;
