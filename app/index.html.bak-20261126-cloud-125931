/* 把用户填的东西整理成真正能调用的端点：
   去空白 → 补协议 → 已是 /chat/completions 就原样 → 是 base 就按平台补全 */
function normalizeApiUrl(raw){
  let s = (raw||'').replace(/[\s\u3000]+/g,'');
  if(!s) return '';
  if(!/^https?:\/\//i.test(s)) s = 'https://' + s;
  let u;
  try{ u = new URL(s); }catch(e){ return s; }
  let p = u.pathname.replace(/\/+$/,'');
  if(/\/chat\/completions$/i.test(p)) return u.origin + p;
  const rule = API_HOSTS.find(r => r[0].test(u.hostname));
  if(rule){
    /* 已知平台：一律用官方端点。路径写错、混进空格、只写到 /v4，都会被纠正 */
    p = rule[1];
  }else{
    p = (!p || p === '/') ? '/v1/chat/completions' : p + '/chat/completions';
  }
  return u.origin + p;
}
function modelFor(url){
  const u = normalizeApiUrl(url);
  const hit = API_HOSTS.find(r => { try{ return r[0].test(new URL(u).hostname); }catch(e){ return false; } });
  return hit ? hit[2] : '';
}

