/* 从缩小的头像里数主色：按出现频率 × 饱和度打分 */
function colorsFromCanvas(cv){
  const g = cv.getContext('2d');
  const d = g.getImageData(0, 0, cv.width, cv.height).data;
  const map = new Map();
  let total = 0;
  for(let i=0; i<d.length; i+=4){
    if(d[i+3] < 200) continue;
    const r=d[i], gg=d[i+1], b=d[i+2];
    const mx = Math.max(r,gg,b), mn = Math.min(r,gg,b);
    if(mx > 246 && mn > 236) continue;     /* 近白，不算颜色 */
    if(mx < 20) continue;                  /* 近黑 */
    total++;
    const k = (r>>4) + ',' + (gg>>4) + ',' + (b>>4);
    const e = map.get(k) || {n:0, r:0, g:0, b:0};
    e.n++; e.r += r; e.g += gg; e.b += b;
    map.set(k, e);
  }
  if(!total) return [];
  return [...map.values()]
    .filter(e=> e.n >= total * 0.015)
    .map(e=>({c: hxs([e.r/e.n, e.g/e.n, e.b/e.n]), n: e.n}))
    .map(e=> Object.assign(e, {s: e.n * (0.3 + sata(e.c) * 1.4)}))
    .sort((a,b)=> b.s - a.s)
    .slice(0,4)
    .map(e=> e.c);
}
async function uploadAvatar(file){
  try{
    const url = URL.createObjectURL(file);
    const img = await new Promise((ok, no)=>{ const i = new Image(); i.onload = ()=>ok(i); i.onerror = no; i.src = url; });
    const size = 256;
    const cv = document.createElement('canvas');
    cv.width = cv.height = size;
    const g = cv.getContext('2d');
    const s = Math.min(img.width, img.height);
    g.drawImage(img, (img.width-s)/2, (img.height-s)/2, s, s, 0, 0, size, size);
    const data = cv.toDataURL('image/png');
    const colors = colorsFromCanvas(cv);
    URL.revokeObjectURL(url);
    const r = await fetch('/api/acct/avatar?uid=' + encodeURIComponent(ACCT.id), {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({uid: ACCT.id, data, colors})
