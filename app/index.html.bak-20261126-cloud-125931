    saveCfg(); applyLook(); renderSet();
    if(state.cfg.anim === 'on') toast('动效已开');
  };

  /* 分组：只改当前这本书，其他书各管各的 */
  const setPer = (v)=>{
    const b2 = curBook();
    if(!b2){ toast('先导入一本书'); return; }
    const num = parseInt(v, 10);
    if(!(num >= 5 && num <= 500)){ toast('填 5 到 500 之间的数'); return; }
    b2.batch = num;
    saveBooks(); renderSet();
    toast('《' + b2.title + '》每组 ' + num + ' 个');
  };

  $('backBtn').onclick = ()=>goBack();
  const ob = $('openDataBtn');
  if(ob) ob.onclick = ()=>{ fetch('/api/open-data', {method:'POST'}).catch(()=>toast('打不开，路径在设置里')); };

  document.querySelectorAll('#chips .chip').forEach(c=>{
    c.onclick = ()=> setPer(c.dataset.n);
  });
  $('batchInput').onchange = e=>{
    if(e.target.value) setPer(e.target.value);
  };

  $('saveKey').onclick = ()=>{
    state.cfg.key = $('keyInput').value.trim();
    state.cfg.url = normalizeApiUrl($('urlInput').value);
    state.cfg.model = $('modelInput').value.trim() || modelFor(state.cfg.url) || 'deepseek-chat';
    $('urlInput').value = state.cfg.url;
    $('modelInput').value = state.cfg.model;
    saveCfg();
    toast(state.cfg.key ? '已保存，拿不准的答案会交给 AI' : '已清空 key');
  };

  $('testKey').onclick = async ()=>{
    const box = $('testResult');
    const key = $('keyInput').value.trim();
    const model = $('modelInput').value.trim() || modelFor($('urlInput').value) || 'deepseek-chat';
    if(!key){ box.innerHTML = '<span class="bad">先填 key 再测。</span>'; return; }
    box.textContent = '正在连接…';
    // 用输入框里的地址当场试，不必先保存
    const saved = state.cfg.url;
    const norm = normalizeApiUrl($('urlInput').value);
    state.cfg.url = norm;
    try{
      const res = await fetch(apiUrl(), {
        method:'POST',
        headers: apiHeaders(key),
        body: JSON.stringify({model, messages:[{role:'user',content:'hi'}], max_tokens:4})
      });
      const txt = await res.text();
      const used = norm || '(默认)';
      if(res.ok){
        box.innerHTML = '<span class="ok">通了，判分可以用。</span><br><span class="dim">' + used + ' · ' + model + '</span>';
      }else if(res.status === 401){
        box.innerHTML = '<span class="bad">通道通了，但 key 被拒（401）。</span><br>检查 key 是否粘贴完整、有无多余空格；也确认 key 和这个平台是不是同一家的。';
      }else if(res.status === 404){
        box.innerHTML = '<span class="bad">地址不对（404）。</span><br>' +
          '服务端说找不到 <code>' + ((txt.match(/"path"\s*:\s*"([^"]*)"/)||[])[1] || '该路径') + '</code>。<br>' +
          '接口地址必须是一个完整的 <code>…/chat/completions</code>。只填到 <code>/v4</code>、<code>/v1</code> 这种 base 是不行的。<br>' +
          '<span class="dim">当前请求的是：' + used + '</span>';
      }else if(res.status === 400){
        box.innerHTML = '<span class="bad">接口拒绝了请求（400）。</span><br>' +
          '最常见是模型名不对——你填的是 <code>' + model + '</code>，去平台控制台核对一下准确的模型 ID。<br>' +
          '<span class="dim">' + txt.slice(0,160).replace(/</g,'&lt;') + '</span>';
      }else{
        box.innerHTML = '<span class="bad">接口返回 ' + res.status + '：</span>' + txt.slice(0,180).replace(/</g,'&lt;') +
          '<br><span class="dim">请求地址：' + used + '</span>';
      }
    }catch(e){
      box.innerHTML = '<span class="bad">连不上（' + e.message + '）。</span>' +
        (DESK ? '<br>桌面版不应出现这个错，重启一次程序再试。'
              : '<br>浏览器直连会被跨域拦，改用桌面版 exe，或先双击 start.cmd 起转发。');
    }finally{
      state.cfg.url = saved;
    }
  };

  $('fileInput').onchange = e=>{
    const f = e.target.files[0]; if(!f) return;
    const nm = f.name.replace(/\.[^.]+$/,'').trim();
    const typed = $('bookTitle').value.trim();
    const rd = new FileReader();
    rd.onload = ()=>{
      doImport(rd.result, typed || nm);
      e.target.value = ''; $('bookTitle').value = '';
    };
    rd.readAsText(f, 'UTF-8');
  };
  $('doImport').onclick = ()=>{
    const t = $('pasteArea').value.trim();
    if(!t){ toast('先粘贴内容'); return; }
    doImport(t, $('bookTitle').value.trim() || ('粘贴导入 · ' + fmtDate(Date.now())));
  };

  $('exportBtn').onclick = ()=>{
    const blob = new Blob([JSON.stringify({
      books:state.books, activeId:state.activeId, cfg:state.cfg, exportedAt:Date.now()
    }, null, 2)], {type:'application/json'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'vocablab-backup.json'; a.click();
    toast('已导出（含书架和全部进度）');
  };

  $('restoreBtn').onclick = ()=> $('restoreInput').click();
  $('restoreInput').onchange = e=>{
    const f = e.target.files[0]; if(!f) return;
    const rd = new FileReader();
    rd.onload = ()=>{
      try{
        const d = JSON.parse(rd.result);
        let m;
        if(Array.isArray(d.books) && d.books.length) m = migrate(d);
        else if(Array.isArray(d.words)) m = migrate({words:d.words, prog:d.prog||{}, session:d.session||null});
        else throw new Error('不是备份文件');
        state.books = m.books;
        state.activeId = m.activeId;
        state.wq = []; state.wi = 0;
        saveBooks(); saveProg(); saveSes();
        renderStats(); switchView('home');
        toast('备份已恢复：' + m.books.length + ' 本书');
      }catch(err){
        toast('这个文件读不了：' + err.message);
      }
      e.target.value = '';
    };
    rd.readAsText(f, 'UTF-8');
  };
  $('resetBtn').onclick = ()=>{
    const b = curBook();
    if(!confirm('清空《' + b.title + '》的学习进度？词条和其他书都不动。')) return;
    b.prog = {}; b.session = null; b.doneAt = null;
    state.wq = []; state.wi = 0;
    saveProg(); saveSes(); saveBooks();
    renderStats(); switchView('home');
    toast('这本书的进度已清空');
  };

  document.addEventListener('keydown', e=>{
    if(state.view === 'read'){
      if(e.code === 'Space'){ e.preventDefault(); if(!state.revealed) revealRead(); }
      if(state.revealed && e.key === '1') gradeRead(true);
      if(state.revealed && e.key === '2') gradeRead(false);
    }
    if(state.view === 'write'){
      if(e.__judged) return;                    /* 这次回车是判分，别再当成「下一个」 */
      writeKeyFlow(e);
    }
  });
}

init();
</script>
</body>
</html>
