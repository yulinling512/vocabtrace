async function genPaletteByAI(btn){
  if(btn){ btn.classList.add('busy'); btn.textContent = '正在配色'; }
  const t0 = Date.now();
  const tick = setInterval(()=>{
    if(btn && btn.classList.contains('busy')) btn.textContent = '正在配色 ' + Math.round((Date.now()-t0)/1000) + ' 秒';
  }, 1000);
  try{
    await loadWeather();
    const ctx = paletteContext();
    const j = await aiPaletteBase(ctx);
    const dark = !!j.dark;
    /* 模型常把底色给得过艳。这里只留它的「色相」，明度统一收进可用区间：
       浅色主题往白里提，深色主题往黑里压，保证正文对比度。 */
    let bg = hx(j.bg) || '#F5F3EE';
    bg = dark ? mixc(bg, '#0B0B0B', .86) : mixc(bg, '#FFFFFF', .87);
    /* 只保留模型给的色相：彩度和明度都由我们定死，
       这样不管它给多淡多灰，出来都是一套能用的强调色。 */
    const L1 = dark ? .70 : .38;
    const a1 = reHue(hx(j.accent) || '#2C6B4A', .56, null, 0, 1, L1);
    const h1 = toHsl(a1)[0];
    const a2 = reHue(hx(j.accent2) || a1, .50, h1, 36, 1, L1 + (dark ? .04 : .02));
    const a3 = reHue(hx(j.accent3) || a1, .46, h1, 42, -1, L1 - (dark ? .03 : .02));
