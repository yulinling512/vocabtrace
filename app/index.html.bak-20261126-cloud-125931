/* ============ 背诵 ============ */
/* 词表按 36 个一页切好（跟纸质默写纸对齐）；页内顺序打乱，页与页按顺序推进 */
const PAGE_SIZE = 36;
function pageNoOf(idx, w){
  const bk = curBook();
  if(bk && bk.batch) return Math.floor(idx / batchSize()) + 1;   /* 自己定过组大小，页码跟着走 */
  return (w && w.pg) || Math.floor(idx / PAGE_SIZE) + 1;
}
function pageMap(){
  const m = new Map();
  state.words.forEach((w,i)=> m.set(w.id, pageNoOf(i,w)));
  return m;
}
function pageTotal(){ return Math.max(1, Math.ceil(state.words.length / batchSize())); }

function shuffle(a){
  const r = a.slice();
  for(let i=r.length-1;i>0;i--){ const j = Math.floor(Math.random()*(i+1)); [r[i],r[j]]=[r[j],r[i]]; }
  return r;
}
/* 一批 = 上次「背了没默写」的（先补上） + 书里还没过的词，凑满一页 */
function pageDone(p){ return !!(p && p.pass); }          /* 默写过了才算真的过 */
function isPassed(p){ return !!(p && p.pass); }

/* ===== 错词：待复习 / 已复习。划掉只是标记，历史一次都不删 ===== */
function wrongWords(){ return state.words.filter(w=>(state.prog[w.id]||{}).wrong>0); }
/* 背和默各自有一份「复习过」标记，互不影响；两侧都过了才算彻底划掉 */
function wrongReadPending(){ return wrongWords().filter(w=>!state.prog[w.id].readCleared); }
function wrongWritePending(){ return wrongWords().filter(w=>!state.prog[w.id].writeCleared); }
function wrongPending(){ return wrongWords().filter(w=>!state.prog[w.id].readCleared || !state.prog[w.id].writeCleared); }
function wrongCleared(){ return wrongWords().filter(w=>state.prog[w.id].readCleared && state.prog[w.id].writeCleared); }
function clearWrong(w, ok, side){
  if(!w) return;
  const p = P(w.id);
  const sides = side === 'read' ? ['read'] : side === 'write' ? ['write'] : ['read','write'];
  sides.forEach(s=>{ p[s+'Cleared'] = !!ok; });
  p.cleared = !!(p.readCleared && p.writeCleared);
  if(p.cleared) p.clearAt = Date.now(); else delete p.clearAt;
}
function sideTags(p){
  p = p || {};
  return `<div class="pills">` +
    `<span class="pill ${p.readCleared?'ok':''}"><span class="mark">${p.readCleared?'✓':''}</span>背</span>` +
    `<span class="pill ${p.writeCleared?'ok':''}"><span class="mark">${p.writeCleared?'✓':''}</span>默</span>` +
  `</div>`;
}
/* 错词复习临时借用背诵/默写页；主会话另存一份，硬盘上永远是主进度 */
function reviewRunning(){ return !!state._mainSession; }
function restoreMainSession(){
  if(!state._mainSession) return;
  state.session = state._mainSession;
  state._mainSession = null; state._revMode = '';
  state.wq = []; state.wi = 0; state.revealed = false;
  saveSes();
}
function startWrongReview(mode, onlyIds){
  /* 从完成页接着练同一批词时，允许直接指定词；它们刚被划掉，不能再按「待复习」过滤 */
  const side = mode === 'read' ? 'read' : 'write';
  const pool = (Array.isArray(onlyIds) && onlyIds.length)
    ? onlyIds.slice()
    : (side === 'read' ? wrongReadPending() : wrongWritePending()).map(w=>w.id);
  if(!pool.length){
    toast(side === 'read' ? '背诵侧没有待复习的错词' : '默写侧没有待复习的错词');
    return;
  }
  if(reviewRunning()) restoreMainSession();
  state._mainSession = JSON.parse(JSON.stringify(state.session || null));
  state._revMode = mode;
  const ids = shuffle(pool);
  state.session = {
    ids, index:0, right:0, done:false, createdAt:Date.now(),
    size:ids.length, page:1, review:'wrong', mode
  };
  state.wq = []; state.wi = 0; state.revealed = false;
  if(mode === 'write'){
    state.wq = ids.slice();
    state.wstat = {ok:0,near:0,bad:0,hold:0,scores:[]};
    state._aiDown = 0; state._wLast = null;
  }
  saveSes();
  switchView(mode);
}

function batchSize(){
  const b = curBook();
  if(b && b.batch) return Math.max(1, Math.min(500, parseInt(b.batch,10) || 0));  /* 单本书可以有自己的节奏 */
  const n = state.cfg.byPage === false ? (parseInt(state.cfg.batch,10) || 20) : PAGE_SIZE;
  return Math.max(1, Math.min(500, n));
}

/* 背过、但那一组没默写：下一次开头先补上 */
function carryOver(){
  const out = [];
  state.words.forEach(w=>{
    const p = state.prog[w.id];
    if(p && (p.seen||0) > 0 && !p.pass) out.push(w);
  });
  return out;
}
/* 按书的顺序往下取没过的词 */
function pickFresh(n, skip){
  const out = [];
  if(n <= 0) return out;
  for(const w of state.words){
    if(out.length >= n) break;
    if(skip && skip.has(w.id)) continue;
    if(isPassed(state.prog[w.id])) continue;
    out.push(w);
  }
  return out;
}
function pendingCount(){
  return state.words.filter(w=>!isPassed(state.prog[w.id])).length;
}
function pageOfWord(w){
  if(!w) return 0;
  const i = state.words.findIndex(x=>x.id===w.id);
  return i < 0 ? 0 : Math.floor(i / batchSize()) + 1;
}

function createSession(){
  const size = batchSize();
  const carry = carryOver();
  const skip = new Set(carry.map(w=>w.id));
  let fresh = pickFresh(size - carry.length, skip);
  let review = false;

  /* 全书都默过了：回头复习错得最多的那一批 */
  if(!carry.length && !fresh.length){
    fresh = state.words.slice().sort((a,b)=>{
      const pa = state.prog[a.id]||{}, pb = state.prog[b.id]||{};
      return (pb.wrong||0)-(pa.wrong||0) || (pa.right||0)-(pb.right||0);
    }).slice(0, size);
    review = true;
  }

  const all = carry.concat(fresh);
  const ids = shuffle(all).map(w=>w.id);
  state.session = {
    ids, index:0, done:false, createdAt:Date.now(), right:0,
    size: ids.length, carry: carry.length, review,
    page: pageOfWord(all[0])
  };
  state.wq = []; state.wi = 0;
  state.revealed = false;
  saveSes();
}

function renderRead(){
  if(!state.words.length){ showEmpty('read','背诵','还没有词库','先去设置里导入一份 CSV','set','去导入'); return; }
  if(!state.session || !state.session.ids || !state.session.ids.length) createSession();

  const s = state.session;
  if(s.done){ renderReadDone(); return; }

  const w = byId(s.ids[s.index]);
  if(!w){ s.done = true; saveSes(); renderReadDone(); return; }

  $('view-read').innerHTML = `
    <div class="pagehd">${backTag()}<h1>背诵</h1><span>第 ${s.index+1} / ${s.ids.length} 个${s.carry?` · 含上次没默的 ${s.carry} 个`:''}</span></div>
    <div class="card"${w.tone?` data-tone="${w.tone}" style="--tone:${toneColor(w.tone)}"`:''}>
      <div class="cw">
        ${w.icon?`<div class="ico">${w.icon}</div>`:''}
        <div class="w">${w.word}</div>
        ${w.phonetic?`<div class="ph">${w.phonetic}</div>`:''}
      </div>
      ${state.revealed?'':'<div class="hint">先自己想一想它的意思，再翻面</div>'}
    </div>
    <div class="row" id="rActions"></div>
    <div class="kbd">空格翻面 · 1 认识 · 2 不认识</div>
  `;
  if(state.revealed) fillBack(w);
  renderReadActions();
  const c = document.querySelector('#view-read .card');
  if(c && !state.revealed && state.cfg.anim !== 'off'){
    c.classList.remove('wsin'); void c.offsetWidth; c.classList.add('wsin');
    clearTimeout(c._wt);
    c._wt = setTimeout(()=>c.classList.remove('wsin'), 700);
  }
}

/* 把 [xxx] 变成高亮标记，内容里的强调全靠它 */
function hilite(s, tag){
  return (s||'').replace(/\[([^\]]+)\]/g, '<'+tag+'>$1</'+tag+'>');
}

/* 每个词的「情绪色调」：由当前主题的主色转出来，仍是一家人 */
const TONE_ROT = {warm:22, cool:-40, dark:64, bright:86, calm:-66, sharp:112};
function toneColor(t){
  if(!t) return '';
  const p = PAL || paletteFromCSS();
  const deg = TONE_ROT[t] == null ? 0 : TONE_ROT[t];
  return fitAccent(rot(p.accent, deg, 1, deg === 64 ? -.05 : 0), p.surface);
}

function fillBack(w, box){
  const card = box || document.querySelector('#view-read .card');
  if(!card) return;
  card.classList.add('full');
  const e = w.etymology || null;
  if(w.tone){ card.dataset.tone = w.tone; card.style.setProperty('--tone', toneColor(w.tone)); }
  else { card.removeAttribute('data-tone'); card.style.removeProperty('--tone'); }

  let h = `<div class="cw">${w.icon?`<div class="ico sm">${w.icon}</div>`:''}<div class="w">${w.word}</div>${w.phonetic?`<div class="ph">${w.phonetic}</div>`:''}</div>`;

  /* 1. 核心义 —— 最先看到答案 */
  h += `<div class="blk"><div class="blk-h">核心释义</div><div class="core">`;
  w.senses.forEach(s=>{
    h += `<div class="sline">${s.pos?`<span class="pos2">${s.pos}</span>`:''}<b>${s.meaning}</b></div>`;
  });
  h += `</div></div>`;

  /* 2. 这词怎么来的 —— 词源与演变，默认展开 */
  if(e && e.t){
    const lab = {etymonline:'可考', wiktionary:'可考', deck:'词库', gen:'', unknown:''}[e.src] || '';
    h += `<div class="blk"><div class="blk-h etyh">这词怎么来的${lab?`<span class="src2">${lab}</span>`:''}${e.c==='low'?'<span class="src2 warn">存疑</span>':''}<span class="arw">▾</span></div>`;
    h += `<div class="ety2 open">`;
    h += `<div class="body"><p>${e.t}</p>`;
    if(e.r && e.r.length) h += '<div class="roots">' + e.r.map(r=>`<span class="root">${r[0]} <i>${r[1]}</i></span>`).join('') + '</div>';
    h += `</div></div></div>`;
  }

  /* 3. 怎么记：拆形 + 词源式钩子 + 联想记忆（后加的，不动前面两块） */
  if(w.hook && w.hook.cut){
    const line = w.hook.line || w.mnemonic || '';
    h += `<div class="blk"><div class="blk-h">怎么记</div><div class="hook">`;
    h += `<div class="cut">${hilite(w.hook.cut,'b')}</div>`;
    if(line) h += `<div class="line">${hilite(line,'em')}</div>`;
    if(w.hook.tip) h += `<div class="tip"><span class="tl">${w.hook.mode || '助记'}</span><span>${hilite(w.hook.tip,'b')}</span></div>`;
    h += `</div></div>`;
  } else if(w.mnemonic){
    h += `<div class="blk"><div class="blk-h">怎么记</div><div class="mn2">${w.mnemonic}</div></div>`;
  }

  /* 4. 例句：只给一句，够用就好，别把按钮顶到屏幕外 */
  if(w.eg && w.eg.length){
    const x = w.eg[0];
    h += `<div class="blk"><div class="blk-h">例句</div>`;
    h += `<div class="eg"><div class="en">${hilite(x[0],'u')}</div>${x[1]?`<div class="cn">${hilite(x[1],'em')}</div>`:''}</div>`;
    h += `</div>`;
  }

  /* 5. 搭配 */
  if(w.col && w.col.length){
    h += `<div class="blk"><div class="blk-h">搭配</div><div class="tags">` +
      w.col.slice(0,3).map(c=>`<span>${c}</span>`).join('') + `</div></div>`;
  }

  /* 6. 易混 */
  if(w.mix && w.mix.length){
    h += `<div class="blk"><div class="blk-h">别认错</div>`;
    w.mix.forEach(m=>{ h += `<div class="mixrow"><b>${m[0]}</b><span>${m[1]}</span></div>`; });
    h += `</div>`;
  }

  /* 7. 词源已前移到第 2 段 */

  card.innerHTML = h;

  const ety = card.querySelector('.ety2');
  const etyH = card.querySelector('.etyh');
  if(ety && etyH) etyH.onclick = ()=>{ etyH.classList.toggle('closed', !ety.classList.toggle('open')); };
}

function renderReadActions(){
  const a = $('rActions'); if(!a) return;
  if(!state.revealed){
    a.innerHTML = '<button class="btn primary" id="rShow">看释义</button>';
    $('rShow').onclick = revealRead;
  }else{
    a.innerHTML = '<button class="btn ghost" id="rNo">没想起来</button><button class="btn primary" id="rYes">记住了</button>';
    $('rNo').onclick = ()=>gradeRead(false);
    $('rYes').onclick = ()=>gradeRead(true);
  }
}

function revealRead(){
  if(state.revealed) return;
  state.revealed = true;
  const w = byId(state.session.ids[state.session.index]);
  const hint = document.querySelector('#view-read .hint');
  if(hint) hint.remove();
  const card = document.querySelector('#view-read .card');
  if(card) card.classList.remove('wsin');
  const noAnim = state.cfg.anim === 'off';
  if(card && !noAnim){
    card.classList.add('flipout');
    setTimeout(()=>{
      card.classList.remove('flipout');
      fillBack(w);
      card.classList.add('flipin');
      renderReadActions();
      setTimeout(()=>card.classList.remove('flipin'), 340);
    }, 165);
  }else{
    fillBack(w);
    renderReadActions();
  }
}

function gradeRead(ok){
  const s = state.session, w = byId(s.ids[s.index]);
  if(!w) return;
  const p = P(w.id);
  p.seen = (p.seen||0) + 1;          /* 背过；但要默过才算这一页走完 */
  p.seenAt = Date.now();
  if(ok){ p.level = Math.min(5, p.level+1); p.right++; s.right = (s.right||0)+1; p.readPass = p.readPass || Date.now(); }
  else { p.level = Math.max(0, p.level-1); p.wrong++; }
  if(s.review === 'wrong') clearWrong(w, ok, 'read');
  saveProg();
  bumpDaily('read');
  s.index++;
  if(s.index >= s.ids.length){ s.done = true; saveSes(); renderReadDone(); checkBookDone(); }
  else { saveSes(); state.revealed = false; renderRead(); }
  renderStats();
}

/* 完成页接着练：不重新挑词、不重置掌握标记，只是再把这一组走一遍 */
function repeatRead(){
  const s = state.session;
  if(!s || !s.ids || !s.ids.length) return;
  s.index = 0; s.done = false; s.right = 0; s.createdAt = Date.now();
  state.revealed = false;
  saveSes(); renderRead();
}
function writeThisSet(){
  const s = state.session;
  if(!s || !s.ids || !s.ids.length) return;
  state.wq = s.ids.slice();
  state.wi = 0;
  state.wstat = {ok:0,near:0,bad:0,hold:0,scores:[]};
  state._wPending = false; state._wLast = null; state._aiDown = 0;
  s.mode = 'write';
  saveSes(); switchView('write');
}
function renderReadDone(){
  const s = state.session;
  const right = s.right || 0;
  $('view-read').innerHTML = `
    <div class="pagehd">${backTag()}<h1>背诵</h1><span>已完成</span></div>
    <div class="card done">
      <div class="big">${s.review === 'wrong' ? '错词背诵复习完了' : (s.review ? '这一组复习完了' : '这一组背完了')}</div>
      <div class="big2">${right} / ${s.ids.length}</div>
      <div class="sub">${right===s.ids.length?'一个都没漏，漂亮。':'没记住的已经进错词本。'}</div>
      <div class="sub" style="margin-top:2px;color:var(--warn)">${s.review === 'wrong'
        ? '只标了背诵这一侧；默写侧还要单独复习。两侧都过了，才算彻底划掉。'
        : '背诵和默写分开记。没默写的话，这一组会留到下次接着默。'}</div>
      <div class="row">
        <button class="btn primary" id="toWrite">去默写这一组</button>
        <button class="btn ghost" id="againSet">再背这一组</button>
        <button class="btn ghost" id="newSet">背下一组</button>
      </div>
    </div>
  `;
  $('toWrite').onclick = writeThisSet;
  $('againSet').onclick = ()=>{ s.done = false; repeatRead(); };
  $('newSet').onclick = ()=>{ restoreMainSession(); createSession(); renderRead(); };
}

/* ============ 默写 ============ */
function startWrite(){
  const s = state.session;
  if(!s || !s.ids || !s.ids.length) return false;
  const seen = s.done ? s.ids.slice() : s.ids.slice(0, s.index);
  if(!seen.length) return false;
  state.wq = shuffle(seen);
  state.wi = 0;
  state.wstat = {ok:0,near:0,bad:0,hold:0,scores:[]};
  state._aiDown = 0; state._wLast = null;
  return true;
}

function renderWrite(){
  state._wPending = false;              /* 换词就清掉判分锁，免得卡住 */
  const s = state.session;
  const noSeen = !s || !s.ids || !s.ids.length || (!s.done && s.index === 0 && s.review !== 'wrong');
  if(!state.words.length || noSeen){
    showEmpty('write','默写','还没有可默写的词','默写只测你刚背过的那一组，先去背一组。','read','去背诵');
    return;
  }
  if(!state.wq.length && !startWrite()) return;
  if(state.wi >= state.wq.length){ renderWriteDone(); return; }

  const w = byId(state.wq[state.wi]);
  if(!w){ state.wi++; renderWrite(); return; }

  const fsm = winFull();               /* 全屏才显示键位、才接管空格 */
  const K = keyCfg();
  $('view-write').innerHTML = `
    <div class="pagehd">${backTag()}<h1>默写</h1><span>第 ${state.wi+1} / ${state.wq.length} 个</span></div>
    <div class="prompt">${w.word}</div>
    <div class="ptext">${w.phonetic||''}</div>
    <textarea id="wInput" placeholder="${fsm?(K.judge==='Space'?'写下它的中文意思。多个意思用逗号或顿号隔开（想打空格就按 Shift+空格）。':'写下它的中文意思。多个意思用逗号或顿号隔开。'):'写下它的中文意思。多个意思用空格或逗号隔开都行。'}"></textarea>
    <div class="row" style="justify-content:flex-start;margin-top:14px">
      <button class="btn primary" id="wSubmit">判分${fsm?'（'+keyLabel(K.judge)+'）':''}</button>
      <button class="btn ghost" id="wSkip">不会，跳过${fsm?'（'+keyLabel(K.skip)+'）':''}</button>
      ${fsm?'':'<span class="kbd" style="margin:0;align-self:center">全屏后可用「'+keyLabel(K.judge)+'」连续作答</span>'}
    </div>
    <div class="result" id="wResult"></div>
    <div class="row" id="wNextRow" style="display:none;justify-content:flex-start">
      <button class="btn primary" id="wNext">下一个${fsm?'（'+keyLabel(K.judge)+'）':''}</button>
    </div>
  `;
  const inp = $('wInput');
  inp.focus();
  inp.addEventListener('keydown', e=>{
    /* 中文输入法还在拼写时，按键归输入法，不抢 */
    if(e.isComposing || e.keyCode === 229) return;
    if(!winFull()) return;               /* 非全屏：空格、句号都还给输入框 */
    const plain = !e.ctrlKey && !e.altKey && !e.metaKey;
    const K = keyCfg();
    /* 判分键；如果它就是空格，Shift+空格 留给真正的空格 */
    if(plain && e.code === K.judge && !(K.judge==='Space' && e.shiftKey)){
      e.preventDefault(); e.__judged = true; submitWrite(); return;
    }
    /* 跳过键：记录物理键位，换中英文输入法也不会变 */
    if(plain && e.code === K.skip){ e.preventDefault(); e.__judged = true; skipWrite(); return; }
    /* Enter 保留作备用；若已被设成判分或跳过，就不重复触发 */
    if(plain && e.code === 'Enter' && K.judge !== 'Enter' && K.skip !== 'Enter'){
      e.preventDefault(); e.__judged = true; submitWrite();
    }
  });
  $('wSubmit').onclick = submitWrite;
  $('wSkip').onclick = skipWrite;
  $('wNext').onclick = nextWrite;
}

/* 默写页的键盘流：判完分后，空格/回车一律算「下一个」，
   不依赖按钮是否拿到焦点，手不用离开键盘 */
/* 只有真全屏（盖住任务栏）时才接管空格，平时窗口化空格还是正常打字 */
function winFull(){
  const b = $('wctl');
  return !!(b && b.classList.contains('fs'));
}
function writeKeyFlow(e){
  if(state.view !== 'write') return false;
  if(e.isComposing || e.keyCode === 229) return false;
  if(!winFull()) return false;
  const row = $('wNextRow');
  if(!row || row.style.display === 'none') return false;
  if(state._wPending) return false;              /* 判分还没回来，先别过 */
  const K = keyCfg();
  if(e.code === K.judge || e.code === 'Enter'){
    e.preventDefault();
    nextWrite();
    return true;
  }
  return false;
}

/* 结果区单独成函数：判错了能就地翻案，不用整块重排 */
function writeResultHtml(d){
  const {w, verdict, score, comment, aiErr, note} = d;
  const label = {ok:'对了', near:'沾边了', bad:'没对上', hold:'待定'}[verdict] || '待定';
  let h = `<div class="verdict v-${verdict}"><span class="dot"></span>${label}</div>`;
  if(verdict === 'hold'){
    h += `<div class="rate-note" style="margin:-2px 0 12px">${note}</div>`;
  } else {
    h += `<div class="rate v-${verdict}">
      <div class="rate-top"><span>接近率</span><b>${score}<i>%</i></b></div>
      <div class="rate-track">
        <div class="rate-fill" style="width:0"></div>
        <div class="rate-pass" style="left:78%"></div>
      </div>
      <div class="rate-legend"><span>0</span><span>100</span></div>
      <div class="rate-note">${note}</div>
    </div>`;
  }
  h += '<div class="ans">' + w.senses.map(s=>`${s.pos?'<span style="color:#6E6A62">'+s.pos+'</span> ':''}${s.meaning}`).join('　｜　') + '</div>';
  if(comment) h += `<div class="ai-note"><em>AI 点评</em>${comment}</div>`;
  else if(aiErr) h += `<div class="ai-note"><em>AI 这次没接上</em>${aiErr}<br>本地规则只认字面，判得偏严，别拿它当判决。</div>`;
  else if(!state.cfg.key && verdict !== 'ok') h += `<div class="ai-note"><em>提示</em>本地规则只认字面。接上 AI 后，意思对但说法不同的答案也能判出接近率。</div>`;
  if(verdict !== 'ok'){
    h += `<div class="row" style="justify-content:flex-start;margin-top:12px">
      <button class="btn ghost" id="wMarkOk" style="font-size:calc(13px * var(--fs));padding:8px 15px">这条算我对</button>
      <span style="font-size:calc(12px * var(--fs));color:var(--faint);align-self:center">你自己裁定，成绩按对记</span>
    </div>`;
  }
  return h;
}
function paintWriteResult(d){
  $('wResult').innerHTML = writeResultHtml(d);
  $('wResult').className = 'result show';
  requestAnimationFrame(()=>{
    const f = document.querySelector('#wResult .rate-fill');
    if(f) f.style.width = Math.min(100, Math.max(2, d.score)) + '%';
  });
  const mo = $('wMarkOk');
  if(mo) mo.onclick = markRight;
}

async function submitWrite(){
  const w = byId(state.wq[state.wi]);
  if(!w) return;
  const box = $('wInput');
  if(!box || box.disabled) return;
  const ans = box.value.trim();
  if(!ans){ toast('先写点什么'); return; }
  if(state._wPending) return;                /* 正在判，别重复提交 */
  state._wPending = true;
  $('wSubmit').disabled = true;
  box.disabled = true;

  const local = localJudge(ans, w.senses);
  let verdict = '', score = local.score, comment = '', aiErr = '';

  if(score >= 78){ verdict = 'ok'; }
  else if(state.cfg.key && (state._aiDown || 0) < 3){
    try{
      const r = await aiJudge(w.word, w.senses, ans);
      if(r){ score = r.score; comment = r.comment || '';
        verdict = r.verdict === 'correct' ? 'ok' : (r.verdict === 'partial' ? 'near' : 'bad'); }
      state._aiDown = 0;
    }catch(e){ aiErr = aiErrText(e); state._aiDown = (state._aiDown || 0) + 1; }
  } else if(state.cfg.key){
    aiErr = '连续几次都没接上，这一组先不调它了';
  }
  if(!verdict){
    /* AI 接不上时，本地字面分不足以定罪：它把「雇佣」判成 24%，既算错又白扣一级。
       这种一律先记“待定”，不碰成绩，交给你自己裁定 */
    verdict = aiErr ? (score >= 20 ? 'hold' : 'bad') : (score >= 48 ? 'near' : 'bad');
  }

  const p = P(w.id);
  if(verdict === 'ok'){ p.level = Math.min(5,p.level+1); p.right++; }
  else if(verdict === 'near'){ p.wrong++; }
  else if(verdict === 'hold'){ /* 待定：不动成绩 */ }
  else { p.level = Math.max(0,p.level-1); p.wrong++; }
  p.pass = p.pass || Date.now();     /* 默过了，这一页就算走完，不再滚到下一批 */
  p.writePass = p.writePass || p.pass;
  if(state.session && state.session.review === 'wrong') clearWrong(w, verdict === 'ok', 'write');
  saveProg(); bumpDaily('write'); renderStats();
  if(state.wstat[verdict] == null) state.wstat[verdict] = 0;
  state.wstat[verdict]++;
  if(!Array.isArray(state.wstat.scores)) state.wstat.scores = [];
  state.wstat.scores.push(score);

  const note = verdict === 'hold' ? 'AI 没回话，本地只认字面，这条先不记成绩'
    : score >= 95 ? '几乎一字不差'
    : score >= 78 ? '意思抓到了，这一遍算过'
    : score >= 48 ? '沾到边了，还差一层意思'
    : (ans.length < 2 ? '只写了一个字，AI 也没法接' : '没落到这本书给的义项上');

  state._wLast = {w, verdict, score, comment, aiErr, note, ans};
  paintWriteResult(state._wLast);
  $('wNextRow').style.display = 'flex';
  state._wPending = false;
  if(winFull()) $('wNext').focus();     /* 全屏才把焦点交给按钮，免得窗口化时空格误触 */
}

/* 判错了就地翻案：把上次判分对成绩的影响撤回，按“对”记一次 */
function markRight(){
  const d = state._wLast;
  if(!d || d.verdict === 'ok') return;
  const p = P(d.w.id), v = d.verdict;
  if(v === 'near' || v === 'bad') p.wrong = Math.max(0, p.wrong - 1);
  if(v === 'bad') p.level = Math.min(5, p.level + 1);     /* 先补回被扣的那级 */
  if((state.wstat[v] || 0) > 0) state.wstat[v]--;
  p.level = Math.min(5, p.level + 1);
  p.right++;
  if(state.session && state.session.review === 'wrong') clearWrong(d.w, true, 'write');
  state.wstat.ok = (state.wstat.ok || 0) + 1;
  const sc = state.wstat.scores;
  if(Array.isArray(sc) && sc.length) sc[sc.length-1] = Math.max(sc[sc.length-1], 90);
  saveProg(); renderStats();

  d.verdict = 'ok';
  d.score = Math.max(d.score, 90);
  d.note = '你自己确认算对，按对记一次';
  d.comment = ''; d.aiErr = '';
  paintWriteResult(d);
  toast('按算对记一次');
}

function skipWrite(){
  const w = byId(state.wq[state.wi]);
  if(!w) return;
  const p = P(w.id);
  p.wrong++;
  p.pass = p.pass || Date.now();     /* 跳过也算过了一遍，进错词本，别拖到明天 */
  p.writePass = p.writePass || p.pass;
  saveProg(); bumpDaily('write'); renderStats();
  state.wstat.bad++;
  if(!Array.isArray(state.wstat.scores)) state.wstat.scores = [];
  state.wstat.scores.push(0);
  $('wInput').disabled = true; $('wSubmit').disabled = true;
  $('wResult').innerHTML = '<div class="verdict v-bad"><span class="dot"></span>跳过了</div>' +
    '<div class="ans">' + w.senses.map(s=>`${s.pos?'<span style="color:#6E6A62">'+s.pos+'</span> ':''}${s.meaning}`).join('　｜　') + '</div>';
  $('wResult').className = 'result show';
  $('wNextRow').style.display = 'flex';
  if(winFull()) $('wNext').focus();
}

function nextWrite(){
  state.wi++;
  if(state.wi >= state.wq.length){
    renderWriteDone();
    checkBookDone();
    return;
  }
  renderWrite();
}

function repeatWrite(){
  const s = state.session;
  if(!s || !s.ids || !s.ids.length) return;
  state.wq = s.ids.slice();
  state.wi = 0;
  state.wstat = {ok:0,near:0,bad:0,hold:0,scores:[]};
  state._wPending = false; state._wLast = null; state._aiDown = 0;
  s.mode = 'write';
  saveSes(); renderWrite();
}
function renderWriteDone(){
  const st = state.wstat, n = state.wq.length || 1;
  const hold = st.hold || 0;
  const base = Math.max(1, n - hold);            /* 待定的没判出来，不算进分母 */
  const rate = Math.round(st.ok / base * 100);
  const sc = Array.isArray(st.scores) ? st.scores : [];
  const avg = sc.length ? Math.round(sc.reduce((a,b)=>a+b,0)/sc.length) : 0;
  $('view-write').innerHTML = `
    <div class="pagehd">${backTag()}<h1>默写</h1><span>已完成</span></div>
    <div class="card done">
      <div class="big">${(state.session && state.session.review === 'wrong') ? '错词默写复习完了' : '这一组默完了'}</div>
      <div class="big2"><span id="wRate">0</span>%</div>
      <div class="sub">对 ${st.ok} · 沾边 ${st.near} · 没对上 ${st.bad}${hold?' · 待定 '+hold:''}</div>
      ${sc.length?`<div class="avgline">平均接近率 <b>${avg}%</b></div>`:''}
      <div class="sub" style="margin-top:2px;color:var(--warn)">背诵和默写分开记，哪一侧答错就回到哪一侧的待复习。</div>
      <div class="row">
        <button class="btn primary" id="again">再默这一组</button>
        <button class="btn ghost" id="toRead">再背这一组</button>
        <button class="btn ghost" id="toWrong">看错词本</button>
        <button class="btn ghost" id="toHome">回首页</button>
      </div>
    </div>
  `;
  $('again').onclick = repeatWrite;
  $('toRead').onclick = ()=>{
    const cur = state.session; if(cur) cur.done = false;
    repeatRead(); switchView('read');
  };
  $('toWrong').onclick = ()=>{ restoreMainSession(); switchView('wrong'); };
  $('toHome').onclick = ()=>{ restoreMainSession(); switchView('home'); };
  countTo($('wRate'), rate);
  if(rate >= 80) confetti(38);
}

