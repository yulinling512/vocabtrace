/* ============ 导入 ============ */
function parseCSV(text){
  text = text.replace(/^\uFEFF/,'');
  const rows=[]; let row=[], cur='', inQ=false;
  for(let i=0;i<text.length;i++){
    const c=text[i];
    if(inQ){
      if(c==='"'){ if(text[i+1]==='"'){cur+='"';i++;} else inQ=false; }
      else cur+=c;
    }else{
      if(c==='"') inQ=true;
      else if(c===','){ row.push(cur); cur=''; }
      else if(c==='\n'){ row.push(cur); rows.push(row); row=[]; cur=''; }
      else if(c==='\r'){ }
      else cur+=c;
    }
  }
  if(cur!==''||row.length){ row.push(cur); rows.push(row); }
  return rows.filter(r=>r.some(x=>x.trim()!==''));
}

function importCSV(text){
  const rows = parseCSV(text);
  if(rows.length < 2) return {ok:false,msg:'文件里没有数据行'};
  const head = rows[0].map(h=>h.trim().toLowerCase());
  const iW = head.indexOf('word'), iM = head.indexOf('meanings');
  const iP = head.indexOf('phonetic');
  if(iW<0 || iM<0) return {ok:false,msg:'表头必须包含 word 和 meanings 两列'};

  const seen = new Map(); let empty=0, dup=0;
  for(let r=1;r<rows.length;r++){
    const row = rows[r];
    const w = (row[iW]||'').trim().toLowerCase();
    const m = (row[iM]||'').trim();
    if(!w) continue;
    if(!m){ empty++; continue; }
    const senses = m.split('|').map(x=>x.trim()).filter(Boolean).map(x=>{
      const mm = x.match(/^(n\.|v\.|adj\.|adv\.|prep\.|conj\.|pron\.|num\.|phr\.)\s*/i);
      return { pos: mm?mm[1]:'', meaning: mm?x.slice(mm[0].length).trim():x };
    });
    const item = { id:w, word:w, phonetic:(iP>=0?(row[iP]||'').trim():''), senses };
    if(seen.has(w)){ dup++; seen.get(w).senses = seen.get(w).senses.concat(senses); continue; }
    seen.set(w, item);
  }
  const words = Array.from(seen.values());
  if(!words.length) return {ok:false,msg:'一个有效词条都没解析出来，检查分隔符是不是半角逗号'};
  return {ok:true, words, empty, dup, total: rows.length-1};
}

/* 导入 = 书架上多一本。旧的那本不动，进度跟着各本书走 */
function doImport(text, title){
  const r = importCSV(text);
  const rp = $('importReport');
  if(!r.ok){ if(rp) rp.innerHTML = '<span style="color:#A8342A">'+esc(r.msg)+'</span>'; return; }
  const name = (title||'').trim() || ('新书 · ' + fmtDate(Date.now()));
  const b = normBook({
    id:uid(), title:name, words:r.words, prog:{}, session:null,
    createdAt:Date.now(), src:'导入'
  });
  state.books.push(b);
  state.activeId = b.id;
  state.wq = []; state.wi = 0;
  saveBooks(); renderStats();

  if(rp){
    rp.innerHTML = '已加入书架：<b>' + esc(name) + '</b> · ' + r.words.length + ' 个词条。' +
      (r.dup? ' 合并重复 ' + r.dup + ' 条。' : '') +
      (r.empty? ' <span style="color:#9A5B12">跳过释义为空 ' + r.empty + ' 条。</span>' : '');
  }
  renderBookList();
  toast('《' + name + '》已上架');
}

