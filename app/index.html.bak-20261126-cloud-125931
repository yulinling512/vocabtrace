  position:absolute;top:-16px;width:7px;height:11px;border-radius:2px;opacity:.95;
  animation:fall linear forwards
}
@keyframes fall{
  0%{transform:translate3d(0,0,0) rotate(0deg);opacity:1}
  70%{opacity:.95}
  100%{transform:translate3d(var(--x),103vh,0) rotate(var(--r));opacity:.7}
}
