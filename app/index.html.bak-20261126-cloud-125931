.card.flipout{animation:flipOut .17s ease-in forwards;transform-origin:center top}
.card.flipin{animation:flipIn .3s var(--ease) both;transform-origin:center top}
.card.wsin{animation:cardUp .4s var(--ease) both}
.tile:active:not(.dis){transform:scale(.982)}
.tile svg{transition:transform .24s var(--ease)}
.tile:hover:not(.dis) svg{transform:translateY(-1.5px) scale(1.07)}
