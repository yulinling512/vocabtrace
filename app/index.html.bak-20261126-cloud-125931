/* 记一层来源，返回键才真的能退回上一级，而不是一律甩回首页 */
function goBack(){
  if(reviewRunning() && (state.view === 'read' || state.view === 'write')) restoreMainSession();
  const prev = (state.nav && state.nav.length) ? state.nav.pop() : '';
  switchView(prev || 'home', true);
}
function backTag(){
  return '<button class="pback" data-back="1" title="返回上一级"><svg viewBox="0 0 16 16"><path d="M9.8 3.2L5 8l4.8 4.8"/></svg>返回</button>';
}
document.addEventListener('click', e=>{
  const b = e.target.closest('[data-back]');
  if(b){ e.preventDefault(); goBack(); }
});
function switchView(v, isBack){
  if(v !== 'set' && keyCapture){ keyCapture = null; paintKeyCfg(); }
  if(!isBack && state.view && state.view !== v){
    if(!Array.isArray(state.nav)) state.nav = [];
    if(state.nav[state.nav.length-1] !== state.view) state.nav.push(state.view);
    if(state.nav.length > 20) state.nav.shift();
  }
  state.view = v;
  document.body.dataset.view = v;
  ['home','shelf','read','write','wrong','set'].forEach(x=>{
    $('view-'+x).style.display = x===v ? (x==='read' ? 'flex' : 'block') : 'none';
  });
  $('backBtn').style.visibility = v==='home' ? 'hidden' : 'visible';

  if(v==='home') renderHome();
  if(v==='shelf') renderShelf();
  if(v==='read'){
    state.revealed = false;
    if(state.session && state.session.done) createSession();
    renderRead();
  }
  if(v==='write'){ if(!state.wq.length) startWrite(); renderWrite(); }
  if(v==='wrong') renderWrong();
  if(v==='set') renderSet();
  renderStats();
  const el = $('view-'+v);
  if(el && state.cfg.anim !== 'off'){
    el.classList.remove('viewin'); void el.offsetWidth; el.classList.add('viewin');
    /* 兜底：万一系统把动画挂起（窗口被挡住、省电模式），一秒后强制收尾，
       否则子元素会停在 opacity:0，整页看着像白屏 */
    clearTimeout(el._vin);
    el._vin = setTimeout(()=>el.classList.remove('viewin'), 950);
  }
  window.scrollTo({top:0});
  refreshChrome();
}

/* ============ 顶栏与滚动提示 ============ */
function refreshChrome(){
  const bar = $('sbar');
  if(bar){
    const h = document.documentElement.scrollHeight, vh = window.innerHeight;
    if(h <= vh + 4){ bar.style.height = '0px'; bar.classList.remove('on'); }
    else{
      const bh = Math.max(30, Math.round(vh * vh / h));
      const y = (window.scrollY / (h - vh)) * (vh - bh);
      bar.style.height = bh + 'px';
      bar.style.transform = 'translateY(' + Math.max(0, Math.min(vh - bh, y)) + 'px)';
    }
  }
  const hd = $('appbar');
  if(hd) hd.classList.toggle('stuck', window.scrollY > 6);
}

/* ============ 账号 ============ */
async function acctApi(p, body){
  const opt = body
    ? {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)}
    : {cache:'no-store'};
  const r = await fetch('/api/acct/' + p, opt);
  const j = await r.json().catch(()=>({ok:false, msg:'本地服务没响应'}));
  if(!r.ok || j.ok === false) throw new Error(j.msg || ('出错了（' + r.status + '）'));
  return j;
}

