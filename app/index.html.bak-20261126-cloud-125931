function showAuth(list){
  ACCT = null;
  state.books = []; state.activeId = ''; state.session = null;
  document.body.classList.add('authing');
  /* 登录页沿用上次的配色，切进来不会突然变成另一个颜色 */
  try{
    const t = localStorage.getItem('vl.lastTheme');
    if(THEMES.includes(t)) document.body.dataset.theme = t;
  }catch(e){}

  let users = (list.users || []).slice();
  let sel = (list.last && users.some(u=>u.id===list.last)) ? list.last : (users[0] ? users[0].id : '');
  let mode = users.length ? 'pick' : 'create';

  let host = $('auth');
  if(!host){ host = document.createElement('div'); host.id = 'auth'; document.body.appendChild(host); }

  function paint(){
    const pick = mode === 'pick';
    const selUser = users.find(x=>x.id===sel);
    host.innerHTML = `
      <div class="acard">
        <div class="amk">${pick && selUser && selUser.hasAvatar ? '<img src="/api/acct/avatar?uid='+selUser.id+'&v='+(selUser.avatarAt||0)+'" alt="">' : '词'}</div>
        <h1>词迹</h1>
        <div class="asub">看英文，想中文。一天一组，背完就默。</div>
        ${pick ? `
          <div class="apick">${users.map(u=>`
            <button class="au${u.id===sel?' on':''}" data-u="${u.id}">
              <i style="background:${u.color||'#2C6B4A'}">${u.hasAvatar?'<img src="/api/acct/avatar?uid='+u.id+'&v='+(u.avatarAt||0)+'" alt="">':esc((u.name||'?').slice(0,1))}</i>
              <span>${esc(u.name)}</span>
            </button>`).join('')}
          </div>
          <input class="ain" id="aPass" type="password" placeholder="密码" autocomplete="current-password">
          <label class="arem"><input type="checkbox" id="aRem" checked><span>记住我，下次直接进</span></label>
          <button class="btn primary abtn" id="aGo">进入</button>
          <div class="aerr" id="aErr"></div>
          <div class="afoot"><button class="alink" id="aNew">新建一个账号</button></div>
        ` : `
          <div class="anew-t">第一次用，先建个账号</div>
          <input class="ain" id="aName" placeholder="名字，比如 steve" maxlength="16" autocomplete="username">
          <input class="ain" id="aPass" type="password" placeholder="密码，至少 4 位" autocomplete="new-password">
          <input class="ain" id="aPass2" type="password" placeholder="再输一次" autocomplete="new-password">
          <button class="btn primary abtn" id="aGo">创建，开始背</button>
          <div class="aerr" id="aErr"></div>
          ${users.length ? '<div class="afoot"><button class="alink" id="aBack">返回登录</button></div>' : ''}
        `}
        <div class="anote">账号只在这台电脑上，密码加密保存，不上传任何地方。</div>
      </div>`;
    bindForm();
    const f = $('aName') || $('aPass');
    if(f) setTimeout(()=>f.focus(), 60);
  }

  function bindForm(){
    host.querySelectorAll('.au').forEach(b=>{
      b.onclick = ()=>{
        sel = b.dataset.u;
        host.querySelectorAll('.au').forEach(x=>x.classList.toggle('on', x===b));
        const p = $('aPass'); if(p){ p.value=''; p.focus(); }
      };
    });
    const nm = $('aNew'); if(nm) nm.onclick = ()=>{ mode='create'; paint(); };
    const bk = $('aBack'); if(bk) bk.onclick = ()=>{ mode='pick'; paint(); };
    const go = $('aGo'); if(go) go.onclick = submit;
    host.querySelectorAll('.ain').forEach(inp=>{
      inp.onkeydown = e=>{ if(e.key === 'Enter'){ e.preventDefault(); submit(); } };
    });
  }

  async function submit(){
    const btn = $('aGo'), err = $('aErr');
    if(!btn || btn.disabled) return;
    err.textContent = '';

    if(mode === 'create'){
      const name = $('aName').value.trim();
      const p1 = $('aPass').value, p2 = $('aPass2').value;
      if(!name) return void (err.textContent = '名字不能空着');
      if(p1.length < 4) return void (err.textContent = '密码至少 4 位');
      if(p1 !== p2) return void (err.textContent = '两次输的不一样');
      btn.disabled = true; btn.textContent = '正在创建…';
      try{
        const j = await acctApi('register', {name, pass:p1});
        await finish(j.user, true);
      }catch(e){
        btn.disabled = false; btn.textContent = '创建，开始背';
        err.textContent = e.message;
      }
      return;
    }

    const u = users.find(x=>x.id===sel);
    if(!u) return void (err.textContent = '先选一个账号');
    const pass = $('aPass').value;
    if(!pass) return void (err.textContent = '先输密码');
    btn.disabled = true; btn.textContent = '正在验证…';
    try{
      const j = await acctApi('login', {name:u.name, pass});
      await finish(j.user, $('aRem') ? !!$('aRem').checked : true);
    }catch(e){
      btn.disabled = false; btn.textContent = '进入';
      err.textContent = e.message;
      $('aPass').select();
    }
  }

  async function finish(user, remember){
    ACCT = {id:user.id, name:user.name, color:user.color, hasAvatar:user.hasAvatar, avatarAt:user.avatarAt, colors:user.colors||[]};
    try{
      if(remember) localStorage.setItem(LS_REMEMBER, user.id);
      else localStorage.removeItem(LS_REMEMBER);
    }catch(e){}
    await enterApp();
  }

  paint();
}

