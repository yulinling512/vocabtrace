main{position:relative;z-index:1}

/* 切页：整页的子元素依次浮上来 */
.viewin > *{animation:riseIn .44s var(--ease) both}
.viewin > *:nth-child(1){animation-delay:.01s}
.viewin > *:nth-child(2){animation-delay:.05s}
.viewin > *:nth-child(3){animation-delay:.09s}
.viewin > *:nth-child(4){animation-delay:.13s}
.viewin > *:nth-child(5){animation-delay:.17s}
