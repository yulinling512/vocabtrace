/* ============ 状态 ============ */
/* 登录后所有本地缓存都挂账号前缀，两个账号在同一个窗口里也不会串数据 */
let ACCT = null;                 // {id,name,color}
const LS = {
  get books(){ return ACCT ? 'vl.'+ACCT.id+'.books' : 'vocablab.books'; },
  get active(){ return ACCT ? 'vl.'+ACCT.id+'.active' : 'vocablab.active'; },
  get deck(){ return ACCT ? 'vl.'+ACCT.id+'.deck' : 'vocablab.deck'; },
  get prog(){ return ACCT ? 'vl.'+ACCT.id+'.prog' : 'vocablab.prog'; },
  get cfg(){ return ACCT ? 'vl.'+ACCT.id+'.cfg' : 'vocablab.cfg'; },
  get ses(){ return ACCT ? 'vl.'+ACCT.id+'.session' : 'vocablab.session'; },
  get meta(){ return ACCT ? 'vl.'+ACCT.id+'.meta' : 'vocablab.meta'; },
  get daily(){ return ACCT ? 'vl.'+ACCT.id+'.daily' : 'vocablab.daily'; }
};
const LS_REMEMBER = 'vl.remember';
let DESK = false;          // 是否跑在桌面版里（有本地服务、数据落盘）
let DESK_FILE = '';        // 数据文件路径，桌面版才有
let pushTimer = null;

/* 一本书 = 一个词库。进度跟着书走，读完盖一个「已过关」章。 */
const state = {
  books:[], activeId:'', cfg:{batch:20},
  view:'home', cur:null, revealed:false,
  wq:[], wi:0, wstat:{ok:0,near:0,bad:0,hold:0}, nav:[], daily:{},
  _mainSession:null, _revMode:''
};
/* 默写快捷键：记物理键位 code，中文输入法下也不会跟句号、空格抢 */
const KEY_DEFAULT = {judge:'Space', skip:'Period'};
function keyCfg(){
  const k = (state.cfg && state.cfg.keys) || {};
  return {judge:k.judge || KEY_DEFAULT.judge, skip:k.skip || KEY_DEFAULT.skip};
}
function keyLabel(code){
  const M = {Space:'空格',Period:'句号 .',Comma:'逗号 ,',Slash:'斜杠 /',Semicolon:'分号 ;',
    Quote:'引号',BracketLeft:'[',BracketRight:']',Minus:'-',Equal:'=',Backslash:'反斜杠',
    Backquote:'反引号',Enter:'回车'};
  if(M[code]) return M[code];
  if(/^Key[A-Z]$/.test(code)) return code.slice(3);
  if(/^Digit\d$/.test(code)) return code.slice(5);
  if(/^Numpad\d+$/.test(code)) return '小键盘'+code.slice(6);
  return code;
}
/* 这些键按下去会挪焦点或翻页，不适合拿来判分 */
const KEY_BAD = ['Escape','Tab','Backspace','Delete','Insert','Home','End',
  'PageUp','PageDown','ArrowUp','ArrowDown','ArrowLeft','ArrowRight',
  'ControlLeft','ControlRight','AltLeft','AltRight','MetaLeft','MetaRight'];
const EMPTY_BOOK = {id:'__empty', title:'空书架', words:[], prog:{}, session:null};

/* ============ 今日统计（跟着账号存盘） ============ */
function statDayKey(ts){
  const d = ts ? new Date(ts) : new Date();
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}
function todayStat(){
  if(!state.daily || typeof state.daily !== 'object') state.daily = {};
  const k = statDayKey();
  if(!state.daily[k]){
    /* 老存档没有这个字段：用现有记录补出今天的数，不让已经背过的重新点一遍 */
    let read = 0, write = 0;
    const s = state.session;
    if(s && s.createdAt && statDayKey(s.createdAt) === k)
      read = s.done ? ((s.ids||[]).length) : (s.index||0);
    Object.keys(state.prog||{}).forEach(id=>{
      const p = state.prog[id];
      if(p && p.pass && statDayKey(p.pass) === k) write++;
    });
    state.daily[k] = {read, write};
    try{ localStorage.setItem(LS.daily, JSON.stringify(state.daily)); }catch(e){}
    pushState();
  }
  return state.daily[k];
}
function bumpDaily(kind){
  const d = todayStat();
  d[kind] = (d[kind]||0) + 1;
  try{ localStorage.setItem(LS.daily, JSON.stringify(state.daily)); }catch(e){}
  pushState();
}

function curBook(){
  return state.books.find(b=>b.id===state.activeId) || state.books[0] || EMPTY_BOOK;
}
/* words / prog / session 都代理到「当前这本书」，老代码照旧写，自动归到书里 */
Object.defineProperty(state,'words',{
  get(){ return curBook().words; },
  set(v){ const b=curBook(); if(b!==EMPTY_BOOK) b.words=v; }
});
Object.defineProperty(state,'prog',{
  get(){ return curBook().prog; },
  set(v){ const b=curBook(); if(b!==EMPTY_BOOK) b.prog=v; }
});
Object.defineProperty(state,'session',{
  get(){ return curBook().session || null; },
  set(v){ const b=curBook(); if(b!==EMPTY_BOOK) b.session=v; }
});

function uid(){ return 'b' + Date.now().toString(36) + Math.random().toString(36).slice(2,5); }
function normBook(b){
  const o = Object.assign({}, b);
  o.id = o.id || uid();
  o.title = (o.title||'未命名').trim();
  o.words = Array.isArray(o.words) ? o.words : [];
  o.prog = o.prog && typeof o.prog === 'object' ? o.prog : {};
  o.session = o.session || null;
  o.createdAt = o.createdAt || Date.now();
  o.doneAt = o.doneAt || null;
  /* v1 → v2：以前"见过就算过"，现在必须默过才算。
     老进度补一次 pass，免得已经过掉的页又回来。只补一次。 */
  if(o.v !== 2){
    Object.keys(o.prog).forEach(k=>{
      const p = o.prog[k];
      if(p && !p.pass && (p.level||0) >= 3) p.pass = p.doneAt || o.createdAt || Date.now();
    });
    o.v = 2;
  }
  /* v3：背诵和默写分开记。老档的 seen 就是背过，cleared 是复习过，按历史原样拆开，不抹记录。
     老代码的 cleared 只可能来自背诵复习（这一批词压根没默过），所以归到背诵侧；默写侧留着待复习 */
  if(o.v !== 3){
    Object.keys(o.prog).forEach(k=>{
      const p = o.prog[k];
      if(!p) return;
      if(p.readPass == null) p.readPass = (p.seen||0) > 0 ? (p.seenAt || p.doneAt || o.createdAt || Date.now()) : 0;
      if(p.writePass == null) p.writePass = p.pass || 0;
      if(p.readCleared == null) p.readCleared = !!p.cleared;
      if(p.writeCleared == null) p.writeCleared = false;
    });
    o.v = 3;
  }
  return o;
}

function buildWords(arr){
  return arr.map(o=>({
    id:o.w, word:o.w, phonetic:o.p||'',
    senses:o.s.map(x=>({pos:x[0], meaning:x[1]})),
    etymology:o.e||null, mnemonic:o.m||''
  }));
}
function P(id){
  if(!state.prog[id]) state.prog[id] = {level:0, right:0, wrong:0};
  return state.prog[id];
}

/* 旧数据只有一份词库，第一次升级时自动把它装成一本书，进度原样搬进去 */
function migrate(data){
  if(data && Array.isArray(data.books) && data.books.length){
    const needSave = data.books.some(b=>!b || (b.v||0) < 3);   /* 老版本数据升级后要落盘一次 */
    const books = data.books.map(normBook);
    const active = books.some(b=>b.id===data.activeId) ? data.activeId : books[0].id;
    return {books, activeId:active, migrated:needSave};
  }
  if(data && Array.isArray(data.words) && data.words.length){
    const b = normBook({
      id:'b_main', title:'高频词默写 600', words:data.words,
      prog:data.prog||{}, session:data.session||null, createdAt:Date.now(), src:'默写纸_答案版.pdf'
    });
    return {books:[b], activeId:b.id, migrated:true};
  }
  const demo = normBook({id:'b_demo', title:'示例 · 26 词', words:buildWords(DEMO), prog:{}});
  return {books:[demo], activeId:demo.id, migrated:true};
}

function load(){
  let data = null;
  try{
    const bj = localStorage.getItem(LS.books);
    if(bj){
      const books = JSON.parse(bj);
      if(Array.isArray(books) && books.length) data = {books, activeId: localStorage.getItem(LS.active)};
    }
  }catch(e){}
  if(!data){
    try{
      const w = JSON.parse(localStorage.getItem(LS.deck) || 'null');
      if(Array.isArray(w) && w.length){
        data = {words:w, prog:JSON.parse(localStorage.getItem(LS.prog)||'{}'),
                session:JSON.parse(localStorage.getItem(LS.ses)||'null')};
      }
    }catch(e){}
  }
  const m = migrate(data);
  state.books = m.books;
  state.activeId = m.activeId;
  if(m.migrated) setTimeout(()=>{ try{ saveBooks(); }catch(e){} }, 60);

  try{
    const c = JSON.parse(localStorage.getItem(LS.cfg) || '{}');
    state.cfg = Object.assign({batch:36, theme:'paper', fs:1, anim:'on'}, c);
    state.cfg.keys = Object.assign({}, KEY_DEFAULT, state.cfg.keys || {});
  }catch(e){ state.cfg = {batch:36, theme:'paper', fs:1, anim:'on', keys:Object.assign({}, KEY_DEFAULT)}; }
  if(!state.cfg.keys) state.cfg.keys = Object.assign({}, KEY_DEFAULT);
  try{ state.daily = JSON.parse(localStorage.getItem(LS.daily) || '{}') || {}; }catch(e){ state.daily = {}; }
  if(state.cfg && state.cfg.url && /api\.deepseek\.com/.test(state.cfg.url)) state.cfg.url = '';
}


/* ============ 配色引擎 ============
   只让 AI 决定 4 个「定义性」颜色，其余全部本地推导：
   对比度、悬停态、弱化文字都由算法兜住，AI 给什么都不会崩。 */
function hx(c){
  c = String(c || '').trim();
  if(/^#?[0-9a-f]{3}$/i.test(c)) c = '#' + c.replace('#','').split('').map(x=>x+x).join('');
  if(!/^#[0-9a-f]{6}$/i.test(c)) return '';
  return c.toLowerCase();
}
function rgb(c){ const h = hx(c) || '#000000'; return [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)]; }
function hxs(a){ return '#' + a.map(v=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0')).join(''); }
function mixc(a,b,t){ const A=rgb(a), B=rgb(b); return hxs(A.map((v,i)=>v + (B[i]-v)*t)); }
function rgba(c,a){ const A=rgb(c); return 'rgba(' + A.join(',') + ',' + a + ')'; }
function lumc(c){
  const A = rgb(c).map(v=>{ v/=255; return v<=.03928 ? v/12.92 : Math.pow((v+.055)/1.055,2.4); });
  return .2126*A[0] + .7152*A[1] + .0722*A[2];
}
function sata(c){ const A=rgb(c); const mx=Math.max.apply(null,A), mn=Math.min.apply(null,A); return mx ? (mx-mn)/mx : 0; }
function contrast(a,b){ const l1=Math.max(lumc(a),lumc(b)), l2=Math.min(lumc(a),lumc(b)); return (l1+.05)/(l2+.05); }
function hsl(h,s,l){
  h = ((h%360)+360)%360/360; s=Math.max(0,Math.min(1,s)); l=Math.max(0,Math.min(1,l));
  const q = l < .5 ? l*(1+s) : l+s-l*s, p = 2*l-q;
  const f = t => { t=(t+1)%1; return t<1/6? p+(q-p)*6*t : t<.5? q : t<2/3? p+(q-p)*(2/3-t)*6 : p; };
  return hxs([f(h+1/3)*255, f(h)*255, f(h-1/3)*255]);
}
function toHsl(c){
  const A = rgb(c).map(v=>v/255);
  const mx = Math.max.apply(null,A), mn = Math.min.apply(null,A), d = mx-mn;
  let h = 0;
  if(d){
    if(mx === A[0]) h = ((A[1]-A[2])/d) % 6;
    else if(mx === A[1]) h = (A[2]-A[0])/d + 2;
    else h = (A[0]-A[1])/d + 4;
    h *= 60; if(h < 0) h += 360;
  }
  const l = (mx+mn)/2;
  const sat = d ? d / (1 - Math.abs(2*l-1)) : 0;
  return [h, sat, l];
}
/* 在同一套气质里换色相：饱和度、明度只做微调，所以多出来的颜色天然是一伙的 */
function rot(c, deg, ds, dl){
  const h = toHsl(c);
  return hsl(h[0] + deg, Math.max(.08, Math.min(.92, h[1] * (ds == null ? 1 : ds))),
             Math.max(.12, Math.min(.84, h[2] + (dl || 0))));
}

/* 模型有时会给一整片灰。这里只保留它的「色相」，把彩度提到能看出颜色的程度；
   三支颜色如果挤在同一色相上，就按方向拉开。 */
function reHue(c, minS, refHue, gap, dir, L){
  const h = toHsl(c);
  let hue = h[0], sat = Math.max(h[1], minS);
  if(refHue != null){
    const d = Math.abs(((hue - refHue + 540) % 360) - 180);
    if(d < gap) hue = (refHue + dir * gap + 360) % 360;
  }
  return hsl(hue, Math.min(.58, sat), L != null ? L : h[2]);
}

/* accent 在 bg 上必须看得清，否则一路加深/提亮到够为止 */
function fitAccent(c, bg){
  let out = hx(c) || '#2C6B4A';
  const dark = lumc(bg) < .42;
  let i = 0;
  while(contrast(out, bg) < 3.4 && i++ < 26) out = mixc(out, dark ? '#FFFFFF' : '#0B0B0B', .07);
  return out;
}
function buildPalette(base){
  base = base || {};
  const bg = hx(base.bg) || '#FBFAF7';
  const dark = base.dark === true || lumc(bg) < .42;
  const surface = hx(base.surface) || (dark ? mixc(bg,'#FFFFFF',.07) : mixc('#FFFFFF', bg, .5));
  const ink = hx(base.ink) || (dark ? mixc('#FFFFFF', bg, .10) : mixc('#15130F', bg, .05));
  const accent = fitAccent(base.accent || '#2C6B4A', bg);
  /* 一套色：一主三辅。AI 给了就用它的，没给就在同一色系里转色相 */
  const accent2 = fitAccent(hx(base.accent2) || rot(accent, 42, 1.02, .01), bg);
  const accent3 = fitAccent(hx(base.accent3) || rot(accent, -80, 1.06, .04), bg);
  const accent4 = fitAccent(rot(accent, 152, .72, .03), bg);   /* 一点点反差色，别太冲 */
  const muted = mixc(ink, bg, dark ? .40 : .55);
  const faint = mixc(ink, bg, dark ? .60 : .70);
  const text2 = mixc(ink, bg, dark ? .22 : .26);
  const line  = mixc(ink, bg, dark ? .80 : .875);
  const accentSoft = mixc(accent, bg, dark ? .81 : .86);
  const accentHover = dark ? mixc(accent, '#FFFFFF', .16) : mixc(accent, '#0B0B0B', .17);
  const onAccent = contrast('#FFFFFF', accent) >= contrast('#141310', accent) ? '#FFFFFF' : '#141310';
  const warn = dark ? '#D9A45C' : '#8A5A12';
  const bad  = dark ? '#E37A6E' : '#A53328';
  const noteBg  = dark ? mixc('#C9A227', bg, .82) : mixc('#C9A227', bg, .90);
  const noteInk = dark ? mixc('#E4C68C', bg, .12) : '#7A4B0C';
  const softBg  = mixc(accent, bg, dark ? .86 : .94);
  const softInk = dark ? mixc(accent, '#FFFFFF', .45) : mixc(accent, '#0B0B0B', .14);
  const badSoft = mixc(bad, bg, dark ? .82 : .90);
  const shadow = dark ? '0 12px 38px -16px rgba(0,0,0,.72)' : '0 12px 34px -18px ' + rgba(ink, .20);
  const soft2 = mixc(accent2, bg, dark ? .80 : .84);
  const soft3 = mixc(accent3, bg, dark ? .80 : .84);
  const soft4 = mixc(accent4, bg, dark ? .80 : .84);
  return {bg, surface, ink, accent, accent2, accent3, accent4,
          soft1: accentSoft, soft2, soft3, soft4,
          muted, faint, text2, line,
          accentSoft, accentHover, onAccent, warn, bad, noteBg, noteInk, softBg, softInk, badSoft, shadow, dark};
}
const PAL_VARS = {
  bg:'--bg', surface:'--surface', ink:'--ink', accent:'--accent', accent2:'--accent-2',
  accent3:'--accent-3', accent4:'--accent-4', soft1:'--c1s', soft2:'--c2s', soft3:'--c3s', soft4:'--c4s',
  muted:'--muted', faint:'--faint', text2:'--text2', line:'--line',
  accentSoft:'--accent-soft', accentHover:'--accent-hover', onAccent:'--on-accent',
  warn:'--warn', bad:'--bad', noteBg:'--note-bg', noteInk:'--note-ink',
  softBg:'--soft-bg', softInk:'--soft-ink', badSoft:'--bad-soft', shadow:'--card-shadow'
};
function applyPalette(base){
  const p = buildPalette(base);
  const st = document.body.style;
  Object.keys(PAL_VARS).forEach(k=> st.setProperty(PAL_VARS[k], p[k]));
  st.setProperty('--toast-bg', p.ink);
  st.setProperty('--toast-ink', p.bg);
  st.setProperty('--header-bg', p.bg);
  return p;
}
function clearPalette(){
  const st = document.body.style;
  Object.keys(PAL_VARS).forEach(k=> st.removeProperty(PAL_VARS[k]));
  ['--toast-bg','--toast-ink','--header-bg'].forEach(k=> st.removeProperty(k));
}

/* 外观：主题 / 字号 / 动画，一处生效到全局 */
const THEMES = ['paper','ink','forest','ocean','clay'];
let PAL = null;
function paletteFromCSS(){
  const cs = getComputedStyle(document.body);
  const g = k => cs.getPropertyValue(k).trim();
  return buildPalette({
    bg: g('--bg'), surface: g('--surface'), ink: g('--ink'),
    accent: g('--accent')
  });
}
function applyLook(){
  const c = state.cfg || {};
  const ai = c.theme === 'ai' && c.pal && c.pal.base;
  const theme = ai ? 'ai' : (THEMES.includes(c.theme) ? c.theme : 'paper');
  document.body.dataset.theme = theme;
  if(ai) PAL = applyPalette(seasonalBase(c.pal.base));
  else { clearPalette(); PAL = paletteFromCSS(); }
  /* 一主三辅：菜单、书脊、词卡按位置轮着用，同一个主题里也有四种颜色 */
  const st = document.body.style;
  [['--c1',PAL.accent,'--c1s',PAL.soft1],['--c2',PAL.accent2,'--c2s',PAL.soft2],
   ['--c3',PAL.accent3,'--c3s',PAL.soft3],['--c4',PAL.accent4,'--c4s',PAL.soft4]]
    .forEach(function(x){ st.setProperty(x[0], x[1]); st.setProperty(x[2], x[3]); });
  if(ACCT){ try{ localStorage.setItem('vl.lastTheme', document.body.dataset.theme); }catch(e){} }
  const fs = parseFloat(c.fs) || 1;
  document.documentElement.style.setProperty('--fs', String(Math.min(1.24, Math.max(.9, fs))));
  document.body.dataset.anim = c.anim === 'off' ? 'off' : 'on';
}

/* ============ 今天是什么日子 ============
   节气用通用的寿星公式算日期（21 世纪够用），天气由本地服务去取，取不到就不显示。 */
const TERMS = [
  ['小寒',1,5.4055],['大寒',1,20.12],['立春',2,3.87],['雨水',2,18.73],
  ['惊蛰',3,5.63],['春分',3,20.646],['清明',4,4.81],['谷雨',4,20.1],
  ['立夏',5,5.52],['小满',5,21.04],['芒种',6,5.678],['夏至',6,21.37],
  ['小暑',7,7.108],['大暑',7,22.83],['立秋',8,7.5],['处暑',8,23.13],
  ['白露',9,7.646],['秋分',9,23.042],['寒露',10,8.318],['霜降',10,23.438],
  ['立冬',11,7.438],['小雪',11,22.36],['大雪',12,7.18],['冬至',12,21.94]
];
function termDay(y, m, c){
  const Y = (m <= 2 ? y - 1 : y) % 100;
  return Math.floor(Y * 0.2422 + c) - Math.floor(Y / 4);
}
function solarTerm(d){
  d = d || new Date();
  const y = d.getFullYear(), list = [];
  [y-1, y].forEach(yy=>{
    TERMS.forEach(function(x){
      list.push({n:x[0], t: new Date(yy, x[1]-1, termDay(yy, x[1], x[2])).getTime()});
    });
  });
  list.sort((a,b)=>a.t-b.t);
  const now = d.getTime();
  let cur = list[0];
  for(const x of list){ if(x.t <= now) cur = x; else break; }
  const nx = list[list.indexOf(cur)+1];
  return {name: cur.n, days: Math.max(0, Math.floor((now - cur.t) / 86400000)), next: nx ? nx.n : ''};
}
/* 季节跟着节气走：立春、立夏、立秋、立冬各换一季 */
function seasonOf(d){
  d = d || new Date();
  const y = d.getFullYear(), list = [];
  [y-1, y].forEach(function(yy){
    [[2,3.87,'春'],[5,5.52,'夏'],[8,7.5,'秋'],[11,7.438,'冬']].forEach(function(x){
      list.push({n:x[2], t:new Date(yy, x[0]-1, termDay(yy, x[0], x[1])).getTime()});
    });
  });
  list.sort((a,b)=>a.t-b.t);
  let cur = '冬';
  for(const x of list){ if(x.t <= d.getTime()) cur = x.n; else break; }
  return cur;
}
function greetWord(d){
  const h = (d || new Date()).getHours();
  if(h < 5) return '夜深了';
  if(h < 9) return '早上好';
  if(h < 12) return '上午好';
  if(h < 14) return '中午好';
  if(h < 18) return '下午好';
  if(h < 23) return '晚上好';
  return '夜深了';
}
let WX = null;
const WX_TTL = 15 * 60 * 1000;      /* 15 分钟换一次，天气变了配色跟着变 */
function wxCity(){ return ((state.cfg && state.cfg.city) || '').trim(); }
function loadWeather(force){
  if(!DESK || !ACCT) return Promise.resolve(null);
  const city = wxCity();
  try{
    const c = JSON.parse(localStorage.getItem('vl.wx') || 'null');
    if(!force && c && c.city0 === city && Date.now() - (c.at||0) < WX_TTL){ WX = c; return Promise.resolve(WX); }
  }catch(e){}
  const q = city ? ('?city=' + encodeURIComponent(city)) : '';
  return fetch('/api/weather' + q, {cache:'no-store'})
    .then(r=>r.json())
    .then(j=>{ if(j && j.ok){ j.city0 = city; WX = j; try{ localStorage.setItem('vl.wx', JSON.stringify(j)); }catch(e){} } return WX; })
    .catch(()=>null);
}

/* ============ 时令层 ============
   AI 配的那套色是「这一季的底子」。时段、天气、节气会变，
   这里按当前时间小幅偏移色相/彩度/明度，底色不动，所以还是同一套，
   只是清晨偏亮、黄昏偏暖、雨雪偏灰、深夜偏暗。 */
function timeMood(d){
  d = d || new Date();
  const h = d.getHours() + d.getMinutes()/60;
  if(h < 5.5)  return {k:'深夜', dh:5,  ds:.88, dl:-.040};
  if(h < 8.5)  return {k:'清晨', dh:-5, ds:1.02, dl:.030};
  if(h < 11)   return {k:'上午', dh:0,  ds:1.02, dl:.018};
  if(h < 14)   return {k:'正午', dh:-2, ds:1.05, dl:.026};
  if(h < 17)   return {k:'下午', dh:2,  ds:1.00, dl:.012};
  if(h < 19.5) return {k:'黄昏', dh:-7, ds:1.05, dl:.020};
  if(h < 22)   return {k:'夜晚', dh:3,  ds:.94, dl:-.026};
  return {k:'深夜', dh:5, ds:.88, dl:-.040};
}
function wxMood(){
  if(!WX || !WX.ok) return {k:'', dh:0, ds:1, dl:0};
  const m = {
    rain:{k:'雨',dh:-4,ds:.90,dl:-.012}, snow:{k:'雪',dh:-6,ds:.80,dl:.026},
    fog:{k:'雾',dh:0,ds:.74,dl:.008},    haze:{k:'霾',dh:4,ds:.68,dl:-.018},
    thunder:{k:'雷雨',dh:-7,ds:.92,dl:-.018}, clear:{k:'晴',dh:2,ds:1.07,dl:.026},
    cloud:{k:'云',dh:0,ds:.93,dl:0}
  }[WX.kind] || {k:'',dh:0,ds:1,dl:0};
  return m;
}
function seasonMood(d){
  const s = seasonOf(d || new Date());
  const m = {春:{dh:-3,ds:1.02,dl:.018}, 夏:{dh:5,ds:1.05,dl:.010},
             秋:{dh:-7,ds:.96,dl:0},     冬:{dh:7,ds:.84,dl:.018}}[s] || {dh:0,ds:1,dl:0};
  return Object.assign({k:s}, m);
}
function seasonalBase(base){
  if(!base) return base;
  const d = new Date();
  const tm = timeMood(d), wm = wxMood(), sm = seasonMood(d);
  const dh = (tm.dh + wm.dh + sm.dh) * .55;
  const ds = tm.ds * wm.ds * sm.ds;
  const dl = tm.dl + wm.dl + sm.dl;
  const tune = c => {
    if(!c) return c;
    const h = toHsl(c);
    return hsl(h[0] + dh, Math.max(.10, Math.min(.72, h[1] * ds)),
               Math.max(.16, Math.min(.80, h[2] + dl)));
  };
  const out = Object.assign({}, base);
  ['accent','accent2','accent3'].forEach(k=>{ if(base[k]) out[k] = tune(base[k]); });
  out.mood = [tm.k, wm.k, sm.k].filter(Boolean).join(' · ');
  return out;
}
/* 每过一小时、天气一变，就重算一次；不是开机那一下算完就定死 */
let _ambTimer = null, _ambKey = '';
function ambientKey(){
  const d = new Date();
  return [d.getFullYear(), d.getMonth(), d.getDate(), d.getHours(),
          (WX && WX.ok) ? (WX.kind + WX.temp) : ''].join('|');
}
function tickAmbient(){
  const k = ambientKey();
  if(k === _ambKey) return;
  _ambKey = k;
  if(state.cfg && state.cfg.theme === 'ai') applyLook();
  if(state.view === 'home') renderHome();
  else if(state.view === 'set') renderSet();
}
function startAmbient(){
  if(_ambTimer) return;
  tickAmbient();
  _ambTimer = setInterval(tickAmbient, 45 * 1000);                    /* 时段跨点就换 */
  setInterval(function(){ loadWeather(true).then(tickAmbient); }, WX_TTL);  /* 15 分钟重取天气 */
}

function dayKey(t){
  const d = new Date(t);
  return d.getFullYear() + '-' + (d.getMonth()+1) + '-' + d.getDate();
}
function studyDaySet(){
  const s = new Set();
  state.words.forEach(w=>{
    const p = state.prog[w.id];
    if(p && p.pass) s.add(dayKey(p.pass));
  });
  return s;
}
function streakDays(){
  const set = studyDaySet();
  if(!set.size) return 0;
  const d = new Date();
  if(!set.has(dayKey(d.getTime()))) d.setDate(d.getDate()-1);   /* 今天还没学，从昨天算 */
  let n = 0;
  while(set.has(dayKey(d.getTime()))){ n++; d.setDate(d.getDate()-1); }
  return n;
}
function passedToday(){
  const k = dayKey(Date.now());
  let n = 0;
  state.words.forEach(w=>{ const p = state.prog[w.id]; if(p && p.pass && dayKey(p.pass) === k) n++; });
  return n;
}
function dateLine(){
  const d = new Date();
  const parts = [(d.getMonth()+1) + ' 月 ' + d.getDate() + ' 日', '周' + '日一二三四五六'[d.getDay()], solarTerm(d).name];
  if(WX && WX.ok && typeof WX.temp === 'number'){
    parts.push(WX.temp + '°' + (WX.text ? ' ' + WX.text : ''));
  }
  const n = passedToday();
  if(n) parts.push('今天已默 ' + n + ' 个');
  return parts.join('<i>·</i>');
}

