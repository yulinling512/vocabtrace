/* 背景：两团极淡的光，慢慢呼吸，别抢内容 */
body::before{
  content:'';position:fixed;left:-12%;right:-12%;top:-18%;height:88vh;z-index:0;pointer-events:none;
  background:
    radial-gradient(40% 42% at 14% 0%, color-mix(in srgb, var(--accent) 14%, transparent) 0%, transparent 72%),
    radial-gradient(34% 38% at 88% 6%, color-mix(in srgb, var(--accent-2) 11%, transparent) 0%, transparent 70%);
  animation:ambient 32s ease-in-out infinite alternate
