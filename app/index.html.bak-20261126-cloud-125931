/* 桌面版：本地存一份，同时往硬盘写一份（防止清缓存、换端口丢数据） */
/* 护栏：还没从硬盘把账号数据读回来之前，任何写盘/打时间戳都禁止，
   否则启动瞬间会用空书架覆盖掉硬盘上的学习记录 */
var HYDRATED = false;
function pushState(){
  if(!DESK) return;
  if(!ACCT) return;                 /* 没登录不落盘，免得写乱别人的文件 */
  if(!HYDRATED) return;
  /* 先把这一刻的数据拍下来：切账号会把内存清空，别把空书架写进硬盘 */
  const snap = {
    uid: ACCT.id, books: state.books, activeId: state.activeId,
    words: state.words, prog: state.prog,
    session: state._mainSession || state.session,
    cfg: state.cfg, daily: state.daily
  };
  const who = ACCT.id;
  clearTimeout(pushTimer);
  pushTimer = setTimeout(()=>{
    try{
      snap.savedAt = Date.now();
      fetch('/api/state?uid=' + encodeURIComponent(who), {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(snap)
      }).catch(()=>{});
    }catch(e){}
  }, 400);
}
function stamp(){ if(!HYDRATED) return; try{ localStorage.setItem(LS.meta, JSON.stringify({savedAt:Date.now()})); }catch(e){} }

