function parsePaletteJSON(txt){
  txt = String(txt || '').trim();
  txt = txt.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();
  let j = null;
  try{ j = JSON.parse(txt); }catch(e){
    /* 模型偶尔会带两句废话，或者被截断，把第一段 JSON 抠出来 */
    const i = txt.search(/[\[{]/);
    if(i >= 0){
      const tail = txt[i] === '[' ? ']' : '}';
      const k = txt.lastIndexOf(tail);
      if(k > i){ try{ j = JSON.parse(txt.slice(i, k+1)); }catch(_){} }
    }
  }
  if(Array.isArray(j)) j = j[0] || {};
  if(j && j.palette) j = j.palette;
  if(!j || !hx(j.bg) || !hx(j.accent)) return null;
  return j;
}
async function aiPaletteBase(ctx){
  const c = state.cfg;
  if(!c.key) throw new Error('还没接 AI，先去下面「AI 判分」填 key');
  const sys = '你是书籍装帧与编辑设计方向的配色师。只输出 JSON，不解释。';
  const user =
`【日期】${ctx.date}
【节气】${ctx.term}
【季节】${ctx.season}
【时段】${ctx.time}
【天气】${ctx.weather}
【头像主色】${ctx.avatar}
【最近在背的词】${ctx.words}

给一个「看英文、想中文」的阅读型背单词应用配一套色。气质：印刷讲究的旧书，克制、低饱和、留白多；颜色要能从上面的节气、天气、季节、词的气质里找到依据。
要一主两辅三支强调色，像同一盒彩铅：色相不同，明度和饱和度接近，放在一起不打架。accent 给按钮和进度，accent2、accent3 给标签、书脊、卡片上的小色块；可以带一点点反差色，活泼但不花。
约束：bg 接近白（明度 ≥ 92%）或接近黑（明度 ≤ 10%），饱和度 ≤ 15%；ink 与 bg 对比度 ≥ 7:1；三支 accent 对 bg 都 ≥ 3.2:1，饱和度 ≤ 60%；氛围偏夜、雨、冬才把 dark 设 true。
只输出：{"name":"2-4字中文色名","note":"不超过24字，说明为什么是这个颜色","dark":false,"bg":"#RRGGBB","surface":"#RRGGBB","ink":"#RRGGBB","accent":"#RRGGBB","accent2":"#RRGGBB","accent3":"#RRGGBB"}`;

  const once = async (model)=>{
    const res = await fetch(apiUrl(), {
      method:'POST',
      headers: apiHeaders(c.key),
      body: JSON.stringify({
        model, temperature: 0.7, max_tokens: 700,
        messages: [{role:'system', content:sys}, {role:'user', content:user}],
        response_format: {type:'json_object'}
      })
    });
    if(!res.ok){
      const e = new Error(res.status === 504 ? '模型想太久，超时了' : ('接口 HTTP ' + res.status));
      e.status = res.status;
      throw e;
    }
    const data = await res.json();
    return (data.choices && data.choices[0].message.content) || '';
  };

  /* 你选的模型优先；断线重试一次，还不行再退到各家的小快模型。
     有些模型「容易断」，所以这里宁可多试一次，也不让你白等。 */
  const fast = paletteModel();
  const plan = [{model: c.model || 'deepseek-chat', tries: 2}];
  if(fast && fast !== plan[0].model) plan.push({model: fast, tries: 1});

  let lastErr = null;
  for(const step of plan){
    for(let i=0; i<step.tries; i++){
      try{
        const txt = await once(step.model);
        const j = parsePaletteJSON(txt);
        if(j) return j;
        lastErr = new Error('颜色给得不完整，再点一次');
      }catch(e){
        lastErr = e;
        if(e.status === 400 || e.status === 401 || e.status === 403) return Promise.reject(e);
        if(i + 1 < step.tries) await new Promise(r=>setTimeout(r, 800));
      }
    }
  }
  throw lastErr || new Error('没拿到颜色');
}
